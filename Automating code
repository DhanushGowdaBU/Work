import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Helper functions
// ==================================================

function toKebabCase(value: string): string {
  return value
    .replace(/([a-z])([A-Z])/g, '$1-$2')
    .replace(/[\s_]+/g, '-')
    .toLowerCase();
}


function toPascalCase(value: string): string {
  return value
    .split('-')
    .filter(Boolean)
    .map(
      part =>
        part.charAt(0).toUpperCase() +
        part.slice(1)
    )
    .join('');
}


function createDirectory(
  directoryPath: string
): void {
  fs.mkdirSync(
    directoryPath,
    {
      recursive: true
    }
  );
}


function createFile(
  filePath: string
): void {
  createDirectory(
    path.dirname(filePath)
  );

  fs.writeFileSync(
    filePath,
    ''
  );
}


// ==================================================
// Paths
// ==================================================

const repoRoot = path.resolve(
  __dirname,
  '../..'
);

const configPath = path.join(
  repoRoot,
  'nyboss-project.yaml'
);

const projectsPath = path.join(
  repoRoot,
  'projects'
);


// ==================================================
// Start
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' NYBOSS Angular Project Generator'
);

console.log(
  '======================================'
);

console.log();


// ==================================================
// 1. Check configuration file
// ==================================================

if (!fs.existsSync(configPath)) {
  throw new Error(
    `Configuration file not found:\n${configPath}`
  );
}


// ==================================================
// 2. Read YAML configuration
// ==================================================

const configText = fs.readFileSync(
  configPath,
  'utf8'
);

const config = parse(
  configText
) as ProjectConfig;


// ==================================================
// 3. Validate application
// ==================================================

if (!config.application) {
  throw new Error(
    'The "application" section is required in nyboss-project.yaml.'
  );
}


if (!config.application.name) {
  throw new Error(
    'application.name is required in nyboss-project.yaml.'
  );
}


const projectName =
  config.application.name.trim();


// ==================================================
// 4. Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {
  throw new Error(
    `Invalid project name '${projectName}'.\n\n` +
    'NYBOSS project names must contain only:\n' +
    '- lowercase letters (a-z)\n' +
    '- numbers (0-9)\n' +
    '- hyphens (-)\n\n' +
    'Examples:\n' +
    '- instrument\n' +
    '- fibo-client-contact\n' +
    '- pledge-dashboard'
  );
}


if (projectName !== projectName.toLowerCase()) {
  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'NYBOSS project names must be lowercase.'
  );
}


console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// 5. Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {
  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );
}


// ==================================================
// 6. Check existing project
// ==================================================

const projectPath = path.join(
  projectsPath,
  projectName
);


if (fs.existsSync(projectPath)) {
  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );
}


console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// 7. Display configuration
// ==================================================

console.log(
  'Requested configuration:'
);

console.log();

console.log(
  `Components: ${
    config.components?.length ?? 0
  }`
);

console.log(
  `Models: ${
    config.models?.length ?? 0
  }`
);

console.log(
  `Services: ${
    config.services?.length ?? 0
  }`
);

console.log(
  `Store: ${
    config.store?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Routing: ${
    config.routing?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Guard: ${
    config.guard?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Tests: ${
    config.tests?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log();


// ==================================================
// 8. Generate Angular application shell
// ==================================================

console.log(
  'Creating Angular application...'
);

console.log();

const angularCli =
  process.platform === 'win32'
    ? 'ng.cmd'
    : 'ng';


const angularArgs = [
  'generate',
  'application',
  projectName,

  '--style',
  'scss',

  '--routing',
  'false',

  '--skip-tests',
  'false',

  '--skip-install'
];


console.log(
  `Running: ng ${angularArgs.join(' ')}`
);

console.log();


const angularProcess = spawnSync(
  angularCli,
  angularArgs,
  {
    cwd: repoRoot,
    stdio: 'inherit',
    shell: true
  }
);


// ==================================================
// 9. Check Angular CLI execution
// ==================================================

if (angularProcess.error) {

  console.error();

  console.error(
    'Failed to start Angular CLI.'
  );

  console.error(
    angularProcess.error
  );

  throw angularProcess.error;
}


if (angularProcess.status !== 0) {

  console.error();

  console.error(
    `Angular CLI exited with code: ${
      angularProcess.status
    }`
  );

  throw new Error(
    'Angular application generation failed.'
  );
}


// ==================================================
// 10. Verify Angular application
// ==================================================

if (!fs.existsSync(projectPath)) {

  throw new Error(
    `Angular CLI completed, but the expected project directory was not found:\n${projectPath}`
  );
}


const generatedAppPath = path.join(
  projectPath,
  'src',
  'app'
);


if (!fs.existsSync(generatedAppPath)) {

  throw new Error(
    `Angular CLI completed, but the expected Angular app directory was not found:\n${generatedAppPath}`
  );
}


// ==================================================
// 11. Create NYBOSS application folder
// ==================================================

console.log(
  'Creating NYBOSS application structure...'
);

console.log();


const nybossAppPath = path.join(
  generatedAppPath,
  projectName
);


const componentsPath = path.join(
  nybossAppPath,
  'components'
);


const modelsPath = path.join(
  nybossAppPath,
  'models'
);


const servicesPath = path.join(
  nybossAppPath,
  'services'
);


const storePath = path.join(
  nybossAppPath,
  'store'
);


// ==================================================
// 12. Create base folders
// ==================================================

createDirectory(
  nybossAppPath
);

createDirectory(
  componentsPath
);

createDirectory(
  modelsPath
);

createDirectory(
  servicesPath
);


if (config.store?.enabled) {

  createDirectory(
    storePath
  );
}


console.log(
  `Created: src/app/${projectName}/`
);

console.log(
  'Created: components/'
);

console.log(
  'Created: models/'
);

console.log(
  'Created: services/'
);


if (config.store?.enabled) {

  console.log(
    'Created: store/'
  );
}

console.log();


// ==================================================
// 13. Create constants
// ==================================================

createFile(
  path.join(
    nybossAppPath,
    `${projectName}.constants.ts`
  )
);

console.log(
  `Created: ${projectName}.constants.ts`
);


// ==================================================
// 14. Create routes
// ==================================================

if (config.routing?.enabled) {

  createFile(
    path.join(
      nybossAppPath,
      `${projectName}.routes.ts`
    )
  );

  console.log(
    `Created: ${projectName}.routes.ts`
  );
}


// ==================================================
// 15. Create guard
// ==================================================

if (config.guard?.enabled) {

  createFile(
    path.join(
      nybossAppPath,
      `${projectName}.guard.ts`
    )
  );

  console.log(
    `Created: ${projectName}.guard.ts`
  );


  if (config.tests?.enabled) {

    createFile(
      path.join(
        nybossAppPath,
        `${projectName}.guard.spec.ts`
      )
    );

    console.log(
      `Created: ${projectName}.guard.spec.ts`
    );
  }
}


console.log();


// ==================================================
// 16. Create model files
// ==================================================

if (config.models?.length) {

  console.log(
    'Creating model files...'
  );

  for (const model of config.models) {

    const modelName =
      toKebabCase(model);

    const modelFilePath =
      path.join(
        modelsPath,
        `${modelName}.model.ts`
      );

    createFile(
      modelFilePath
    );

    console.log(
      `Created: models/${modelName}.model.ts`
    );
  }

  console.log();
}


// ==================================================
// 17. Create service files
// ==================================================

if (config.services?.length) {

  console.log(
    'Creating service files...'
  );

  for (const service of config.services) {

    const serviceName =
      toKebabCase(service);

    const serviceFilePath =
      path.join(
        servicesPath,
        `${serviceName}.service.ts`
      );

    createFile(
      serviceFilePath
    );

    console.log(
      `Created: services/${serviceName}.service.ts`
    );


    if (config.tests?.enabled) {

      const serviceSpecPath =
        path.join(
          servicesPath,
          `${serviceName}.service.spec.ts`
        );

      createFile(
        serviceSpecPath
      );

      console.log(
        `Created: services/${serviceName}.service.spec.ts`
      );
    }
  }

  console.log();
}


// ==================================================
// 18. Create component files
// ==================================================

if (config.components?.length) {

  console.log(
    'Creating component files...'
  );

  for (const component of config.components) {

    const componentName =
      toKebabCase(component.name);

    const componentType =
      component.type
        .trim()
        .toLowerCase();


    const componentPath =
      path.join(
        componentsPath,
        componentName
      );


    // ----------------------------------------------
    // Component directory
    // ----------------------------------------------

    createDirectory(
      componentPath
    );


    // ----------------------------------------------
    // Component files
    // ----------------------------------------------

    createFile(
      path.join(
        componentPath,
        `${componentName}.component.ts`
      )
    );


    createFile(
      path.join(
        componentPath,
        `${componentName}.component.html`
      )
    );


    createFile(
      path.join(
        componentPath,
        `${componentName}.component.scss`
      )
    );


    if (config.tests?.enabled) {

      createFile(
        path.join(
          componentPath,
          `${componentName}.component.spec.ts`
        )
      );
    }


    // ----------------------------------------------
    // Component-specific files
    // ----------------------------------------------

    if (
      componentType === 'grid'
    ) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-data-source.service.ts`
        )
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentPath,
            `${componentName}-data-source.service.spec.ts`
          )
        );
      }


      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.ts`
        )
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentPath,
            `${componentName}-view.service.spec.ts`
          )
        );
      }
    }


    if (
      componentType === 'modal' ||
      componentType === 'wrapper'
    ) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.ts`
        )
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentPath,
            `${componentName}-view.service.spec.ts`
          )
        );
      }
    }


    console.log(
      `Created component: ${componentName} (${componentType})`
    );
  }

  console.log();
}


// ==================================================
// 19. Create store files
// ==================================================

if (config.store?.enabled) {

  console.log(
    'Creating store files...'
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.actions.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.effects.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.effects.spec.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.reducer.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.reducer.spec.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.selectors.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.state.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.store.ts`
    )
  );


  console.log(
    `Created store files for: ${projectName}`
  );

  console.log();
}


// ==================================================
// 20. Generation summary
// ==================================================

console.log(
  '======================================'
);

console.log(
  ' Generation completed'
);

console.log(
  '======================================'
);

console.log();

console.log(
  `Project : ${projectName}`
);

console.log(
  `Location: projects/${projectName}`
);

console.log();

console.log(
  'Angular workspace configuration was updated by Angular CLI.'
);

console.log();

console.log(
  'NYBOSS folder and file structure has been created.'
);

console.log();

console.log(
  'Generated files are intentionally empty.'
);

console.log();
