// ==================================================
// Store generation
// ==================================================

function generateStore(
  projectName: string,
  storePath: string,
  generateTests: boolean
): void {

  const className =
    toPascalCase(projectName);


  // ==================================================
  // State
  // ==================================================

  createFile(
    path.join(
      storePath,
      `${projectName}.state.ts`
    ),

    `export interface ${className}State {
  loading: boolean;
  error: unknown;
}


export const initial${className}State: ${className}State = {
  loading: false,
  error: null
};
`
  );


  // ==================================================
  // Actions
  // ==================================================

  createFile(
    path.join(
      storePath,
      `${projectName}.actions.ts`
    ),

    `import { createAction, props } from '@ngrx/store';

export const load${className} =
  createAction(
    '[${className}] Load'
  );


export const load${className}Success =
  createAction(
    '[${className}] Load Success',
    props<{ data: unknown }>()
  );


export const load${className}Failure =
  createAction(
    '[${className}] Load Failure',
    props<{ error: unknown }>()
  );
`
  );


  // ==================================================
  // Reducer
  // ==================================================

  createFile(
    path.join(
      storePath,
      `${projectName}.reducer.ts`
    ),

    `import {
  createReducer,
  on
} from '@ngrx/store';

import {
  load${className},
  load${className}Success,
  load${className}Failure
} from './${projectName}.actions';

import {
  ${className}State,
  initial${className}State
} from './${projectName}.state';


export const ${projectName}Reducer =
  createReducer(

    initial${className}State,

    on(
      load${className},
      state => ({
        ...state,
        loading: true,
        error: null
      })
    ),

    on(
      load${className}Success,
      state => ({
        ...state,
        loading: false,
        error: null
      })
    ),

    on(
      load${className}Failure,
      (state, { error }) => ({
        ...state,
        loading: false,
        error
      })
    )

  );
`
  );


  // ==================================================
  // Reducer test
  // ==================================================

  if (generateTests) {

    createFile(
      path.join(
        storePath,
        `${projectName}.reducer.spec.ts`
      ),

      `import {
  ${projectName}Reducer
} from './${projectName}.reducer';

import {
  initial${className}State
} from './${projectName}.state';


describe(
  '${className}Reducer',
  () => {

    it(
      'should return the initial state',
      () => {

        const state =
          ${projectName}Reducer(
            undefined,
            { type: '@@init' }
          );

        expect(state)
          .toEqual(
            initial${className}State
          );

      }
    );

  }
);
`
    );
  }


  // ==================================================
  // Effects
  // ==================================================

  createFile(
    path.join(
      storePath,
      `${projectName}.effects.ts`
    ),

    `import { Injectable } from '@angular/core';

import {
  Actions
} from '@ngrx/effects';

import {
  ofType
} from '@ngrx/effects';

import {
  map
} from 'rxjs/operators';

import {
  load${className},
  load${className}Success
} from './${projectName}.actions';


@Injectable()
export class ${className}Effects {

  load$ = this.actions$.pipe(

    ofType(
      load${className}
    ),

    map(() =>
      load${className}Success({
        data: null
      })
    )

  );


  constructor(
    private readonly actions$: Actions
  ) {
  }

}
`
  );


  // ==================================================
  // Effects test
  // ==================================================

  if (generateTests) {

    createFile(
      path.join(
        storePath,
        `${projectName}.effects.spec.ts`
      ),

      `import { TestBed } from '@angular/core/testing';

import {
  provideMockActions
} from '@ngrx/effects/testing';

import {
  Observable,
  of
} from 'rxjs';

import {
  ${className}Effects
} from './${projectName}.effects';

import {
  load${className},
  load${className}Success
} from './${projectName}.actions';


describe(
  '${className}Effects',
  () => {

    let effects:
      ${className}Effects;

    let actions$: Observable<unknown>;


    beforeEach(() => {

      TestBed.configureTestingModule({

        providers: [

          ${className}Effects,

          provideMockActions(
            () => actions$
          )

        ]

      });


      effects =
        TestBed.inject(
          ${className}Effects
        );

    });


    it(
      'should be created',
      () => {

        expect(effects)
          .toBeTruthy();

      }
    );

  }
);
`
    );
  }


  // ==================================================
  // Selectors
  // ==================================================

  createFile(
    path.join(
      storePath,
      `${projectName}.selectors.ts`
    ),

    `import {
  createFeatureSelector,
  createSelector
} from '@ngrx/store';

import {
  ${className}State
} from './${projectName}.state';


export const select${className}State =
  createFeatureSelector<${className}State>(
    '${projectName}'
  );


export const select${className}Loading =
  createSelector(
    select${className}State,
    state => state.loading
  );


export const select${className}Error =
  createSelector(
    select${className}State,
    state => state.error
  );
`
  );


  // ==================================================
  // Store
  // ==================================================

  createFile(
    path.join(
      storePath,
      `${projectName}.store.ts`
    ),

    `import {
  Store
} from '@ngrx/store';

import {
  ${className}State
} from './${projectName}.state';


export type ${className}Store =
  Store<${className}State>;
`
  );


  console.log(
    `Created store for: ${projectName}`
  );
}


// ==================================================
// Paths
// ==================================================

const repoRoot =
  path.resolve(
    __dirname,
    '../..'
  );


const configPath =
  path.join(
    repoRoot,
    'nyboss-project.yaml'
  );


const projectsPath =
  path.join(
    repoRoot,
    'projects'
  );


// ==================================================
// Start
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' NYBOSS Angular Project Generator'
);

console.log(
  '======================================'
);

console.log();


// ==================================================
// 1. Check configuration file
// ==================================================

if (!fs.existsSync(configPath)) {

  throw new Error(
    `Configuration file not found:\n${configPath}`
  );

}


// ==================================================
// 2. Read YAML
// ==================================================

const configText =
  fs.readFileSync(
    configPath,
    'utf8'
  );


const config =
  parse(
    configText
  ) as ProjectConfig;


// ==================================================
// 3. Validate application
// ==================================================

if (!config.application) {

  throw new Error(
    'The "application" section is required in nyboss-project.yaml.'
  );

}


if (!config.application.name) {

  throw new Error(
    'application.name is required in nyboss-project.yaml.'
  );

}


const projectName =
  config.application.name.trim();


// ==================================================
// 4. Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {

  throw new Error(
    `Invalid project name '${projectName}'.\n\n` +
    'NYBOSS project names must contain only:\n' +
    '- lowercase letters (a-z)\n' +
    '- numbers (0-9)\n' +
    '- hyphens (-)\n\n' +
    'Examples:\n' +
    '- instrument\n' +
    '- fibo-client-contact\n' +
    '- pledge-dashboard'
  );

}


if (projectName !== projectName.toLowerCase()) {

  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'NYBOSS project names must be lowercase.'
  );

}


console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// 5. Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {

  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );

}


// ==================================================
// 6. Check existing project
// ==================================================

const projectPath =
  path.join(
    projectsPath,
    projectName
  );


if (fs.existsSync(projectPath)) {

  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );

}


console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// 7. Display configuration
// ==================================================

console.log(
  'Requested configuration:'
);

console.log();


console.log(
  `Components: ${
    config.components?.length ?? 0
  }`
);


console.log(
  `Models: ${
    config.models?.length ?? 0
  }`
);


console.log(
  `Services: ${
    config.services?.length ?? 0
  }`
);


console.log(
  `Store: ${
    config.store?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Routing: ${
    config.routing?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Guard: ${
    config.guard?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Tests: ${
    config.tests?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log();


// ==================================================
// 8. Generate Angular application
// ==================================================

console.log(
  'Creating Angular application...'
);

console.log();


const angularCli =
  process.platform === 'win32'
    ? 'ng.cmd'
    : 'ng';


const angularArgs = [
  'generate',
  'application',
  projectName,

  '--style',
  'scss',

  '--routing',
  'false',

  '--skip-tests',
  'false',

  '--skip-install'
];


console.log(
  `Running: ng ${angularArgs.join(' ')}`
);

console.log();


// ==================================================
// 9. Execute Angular CLI
// ==================================================

const angularProcess =
  spawnSync(
    angularCli,
    angularArgs,
    {
      cwd: repoRoot,
      stdio: 'inherit',
      shell: true
    }
  );


// ==================================================
// 10. Check Angular CLI process
// ==================================================

if (angularProcess.error) {

  console.error();

  console.error(
    'Failed to start Angular CLI.'
  );

  console.error(
    angularProcess.error
  );

  throw angularProcess.error;
}


if (angularProcess.status !== 0) {

  console.error();

  console.error(
    `Angular CLI exited with code: ${
      angularProcess.status
    }`
  );

  throw new Error(
    'Angular application generation failed.'
  );
}


// ==================================================
// 11. Verify generated project
// ==================================================

if (!fs.existsSync(projectPath)) {

  throw new Error(
    `Angular CLI completed, but the expected project directory was not found:\n${projectPath}`
  );

}


const generatedAppPath =
  path.join(
    projectPath,
    'src',
    'app'
  );


if (!fs.existsSync(generatedAppPath)) {

  throw new Error(
    `Angular CLI completed, but the expected Angular app directory was not found:\n${generatedAppPath}`
  );

}


// ==================================================
// 12. Create NYBOSS application structure
// ==================================================

console.log(
  'Creating NYBOSS application structure...'
);

console.log();


const nybossAppPath =
  path.join(
    generatedAppPath,
    projectName
  );


const componentsPath =
  path.join(
    nybossAppPath,
    'components'
  );


const modelsPath =
  path.join(
    nybossAppPath,
    'models'
  );


const servicesPath =
  path.join(
    nybossAppPath,
    'services'
  );


const storePath =
  path.join(
    nybossAppPath,
    'store'
  );


// Components

fs.mkdirSync(
  componentsPath,
  {
    recursive: true
  }
);


// Models

fs.mkdirSync(
  modelsPath,
  {
    recursive: true
  }
);


// Services

fs.mkdirSync(
  servicesPath,
  {
    recursive: true
  }
);


// Store

if (config.store?.enabled) {

  fs.mkdirSync(
    storePath,
    {
      recursive: true
    }
  );

}


console.log(
  `Created: src/app/${projectName}/`
);

console.log(
  'Created: components/'
);

console.log(
  'Created: models/'
);

console.log(
  'Created: services/'
);


if (config.store?.enabled) {

  console.log(
    'Created: store/'
  );

}

console.log();


// ==================================================
// 13. Create application constants
// ==================================================

const applicationClassName =
  toPascalCase(
    projectName
  );


const constantsPath =
  path.join(
    nybossAppPath,
    `${projectName}.constants.ts`
  );


createFile(
  constantsPath,

  `export const ${applicationClassName}Constants = {
};
`
);


console.log(
  `Created: ${projectName}.constants.ts`
);


// ==================================================
// 14. Create routing
// ==================================================

if (config.routing?.enabled) {

  const routesPath =
    path.join(
      nybossAppPath,
      `${projectName}.routes.ts`
    );


  createFile(
    routesPath,

    `import { Routes } from '@angular/router';

export const ${applicationClassName}Routes: Routes = [
];
`
  );


  console.log(
    `Created: ${projectName}.routes.ts`
  );

}


// ==================================================
// 15. Create guard
// ==================================================

if (config.guard?.enabled) {

  const guardPath =
    path.join(
      nybossAppPath,
      `${projectName}.guard.ts`
    );


  createFile(
    guardPath,

    `import { CanActivateFn } from '@angular/router';

export const ${applicationClassName}Guard: CanActivateFn = () => {
  return true;
};
`
  );


  console.log(
    `Created: ${projectName}.guard.ts`
  );


  if (config.tests?.enabled) {

    const guardSpecPath =
      path.join(
        nybossAppPath,
        `${projectName}.guard.spec.ts`
      );


    createFile(
      guardSpecPath,

      `import {
  ${applicationClassName}Guard
} from './${projectName}.guard';


describe('${applicationClassName}Guard', () => {

  it('should be defined', () => {

    expect(
      ${applicationClassName}Guard
    ).toBeTruthy();

  });

});
`
    );


    console.log(
      `Created: ${projectName}.guard.spec.ts`
    );

  }

}


console.log();


// ==================================================
// 16. Generate components
// ==================================================

if (config.components?.length) {

  console.log(
    'Generating components...'
  );

  console.log();


  for (
    const component
    of config.components
  ) {

    generateComponent(
      component,
      componentsPath,
      config.tests?.enabled ?? false
    );

  }


  console.log();

  console.log(
    `Generated ${
      config.components.length
    } component(s).`
  );

  console.log();

}


// ==================================================
// 17. Generate models
// ==================================================

if (config.models?.length) {

  console.log(
    'Generating models...'
  );

  console.log();


  for (
    const model
    of config.models
  ) {

    generateModel(
      model,
      modelsPath
    );

  }


  console.log();

  console.log(
    `Generated ${
      config.models.length
    } model(s).`
  );

  console.log();

}


// ==================================================
// 18. Generate services
// ==================================================

if (config.services?.length) {

  console.log(
    'Generating services...'
  );

  console.log();


  for (
    const service
    of config.services
  ) {

    generateService(
      service,
      servicesPath,
      config.tests?.enabled ?? false
    );

  }


  console.log();

  console.log(
    `Generated ${
      config.services.length
    } service(s).`
  );

  console.log();

}


// ==================================================
// 19. Generate store
// ==================================================

if (config.store?.enabled) {

  console.log(
    'Generating store...'
  );

  console.log();


  generateStore(
    projectName,
    storePath,
    config.tests?.enabled ?? false
  );


  console.log();

}


