import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Helper functions
// ==================================================

function toPascalCase(value: string): string {
  return value
    .split('-')
    .filter(Boolean)
    .map(
      part =>
        part.charAt(0).toUpperCase() +
        part.slice(1)
    )
    .join('');
}


function toKebabCase(value: string): string {
  return value
    .replace(/([a-z])([A-Z])/g, '$1-$2')
    .replace(/[\s_]+/g, '-')
    .toLowerCase();
}


function createFile(
  filePath: string,
  content: string
): void {

  fs.mkdirSync(
    path.dirname(filePath),
    {
      recursive: true
    }
  );

  fs.writeFileSync(
    filePath,
    content
  );
}


function validateComponentType(
  type: string
): void {

  const supportedTypes = [
    'grid',
    'modal',
    'standard',
    'wrapper'
  ];

  if (!supportedTypes.includes(type)) {

    throw new Error(
      `Unsupported component type '${type}'.\n` +
      `Supported types: ${supportedTypes.join(', ')}`
    );
  }
}


// ==================================================
// Component generation
// ==================================================

function generateComponent(
  component: {
    name: string;
    type: string;
  },
  componentsPath: string,
  generateTests: boolean
): void {

  const componentName =
    toKebabCase(component.name);

  const className =
    toPascalCase(componentName);

  validateComponentType(
    component.type
  );

  const componentPath =
    path.join(
      componentsPath,
      componentName
    );

  console.log(
    `Generating component: ${componentName} (${component.type})`
  );


  // ==================================================
  // Component TypeScript
  // ==================================================

  createFile(
    path.join(
      componentPath,
      `${componentName}.component.ts`
    ),

    `import { Component } from '@angular/core';

@Component({
  selector: 'app-${componentName}',
  standalone: true,
  templateUrl: './${componentName}.component.html',
  styleUrl: './${componentName}.component.scss'
})
export class ${className}Component {
}
`
  );


  // ==================================================
  // Component HTML
  // ==================================================

  createFile(
    path.join(
      componentPath,
      `${componentName}.component.html`
    ),

    `<div class="${componentName}">
  ${className} component
</div>
`
  );


  // ==================================================
  // Component SCSS
  // ==================================================

  createFile(
    path.join(
      componentPath,
      `${componentName}.component.scss`
    ),

    `.${componentName} {
}
`
  );


  // ==================================================
  // Component test
  // ==================================================

  if (generateTests) {

    createFile(
      path.join(
        componentPath,
        `${componentName}.component.spec.ts`
      ),

      `import {
  ComponentFixture,
  TestBed
} from '@angular/core/testing';

import {
  ${className}Component
} from './${componentName}.component';


describe('${className}Component', () => {

  let component: ${className}Component;

  let fixture:
    ComponentFixture<${className}Component>;


  beforeEach(async () => {

    await TestBed.configureTestingModule({
      imports: [
        ${className}Component
      ]
    }).compileComponents();


    fixture =
      TestBed.createComponent(
        ${className}Component
      );


    component =
      fixture.componentInstance;


    fixture.detectChanges();
  });


  it('should create', () => {

    expect(component)
      .toBeTruthy();

  });

});
`
    );
  }


  // ==================================================
  // Grid-specific files
  // ==================================================

  if (component.type === 'grid') {

    createFile(
      path.join(
        componentPath,
        `${componentName}-view.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}ViewService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.spec.ts`
        ),

        `import {
  ${className}ViewService
} from './${componentName}-view.service';


describe('${className}ViewService', () => {

  it('should be created', () => {

    const service =
      new ${className}ViewService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }


    createFile(
      path.join(
        componentPath,
        `${componentName}-data-source.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}DataSourceService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-data-source.service.spec.ts`
        ),

        `import {
  ${className}DataSourceService
} from './${componentName}-data-source.service';


describe('${className}DataSourceService', () => {

  it('should be created', () => {

    const service =
      new ${className}DataSourceService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }
  }


  // ==================================================
  // Wrapper-specific files
  // ==================================================

  if (component.type === 'wrapper') {

    createFile(
      path.join(
        componentPath,
        `${componentName}-view.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}ViewService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.spec.ts`
        ),

        `import {
  ${className}ViewService
} from './${componentName}-view.service';


describe('${className}ViewService', () => {

  it('should be created', () => {

    const service =
      new ${className}ViewService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }
  }


  // ==================================================
  // Modal-specific files
  // ==================================================

  if (component.type === 'modal') {

    createFile(
      path.join(
        componentPath,
        `${componentName}-view.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}ViewService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.spec.ts`
        ),

        `import {
  ${className}ViewService
} from './${componentName}-view.service';


describe('${className}ViewService', () => {

  it('should be created', () => {

    const service =
      new ${className}ViewService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }
  }
}


