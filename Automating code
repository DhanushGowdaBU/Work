import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Paths
// ==================================================

const repoRoot = path.resolve(__dirname, '../..');

const configPath = path.join(
  repoRoot,
  'nyboss-project.yaml'
);

const projectsPath = path.join(
  repoRoot,
  'projects'
);


// ==================================================
// Start
// ==================================================

console.log('======================================');
console.log(' NYBOSS Angular Project Generator');
console.log('======================================');
console.log();


// ==================================================
// Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {
  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );
}


// ==================================================
// Read YAML configuration
// ==================================================

if (!fs.existsSync(configPath)) {
  throw new Error(
    `Configuration file not found:\n${configPath}`
  );
}

const configText = fs.readFileSync(
  configPath,
  'utf8'
);

const config = parse(
  configText
) as ProjectConfig;


// ==================================================
// Validate application configuration
// ==================================================

if (!config.application) {
  throw new Error(
    'The "application" section is required in nyboss-project.yaml'
  );
}

if (!config.application.name) {
  throw new Error(
    'application.name is required in nyboss-project.yaml'
  );
}

const projectName =
  config.application.name.trim();


// ==================================================
// Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {
  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'Use lowercase letters, numbers and hyphens only.'
  );
}

console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// Determine project path
// ==================================================

const projectPath = path.join(
  projectsPath,
  projectName
);

console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// Check whether project already exists
// ==================================================

if (fs.existsSync(projectPath)) {
  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );
}


// ==================================================
// Show requested configuration
// ==================================================

console.log('Requested configuration:');
console.log();

console.log(
  `Components: ${
    config.components?.length ?? 0
  }`
);

console.log(
  `Models: ${
    config.models?.length ?? 0
  }`
);

console.log(
  `Services: ${
    config.services?.length ?? 0
  }`
);

console.log(
  `Store: ${
    config.store?.enabled ? 'enabled' : 'disabled'
  }`
);

console.log(
  `Routing: ${
    config.routing?.enabled ? 'enabled' : 'disabled'
  }`
);

console.log(
  `Guard: ${
    config.guard?.enabled ? 'enabled' : 'disabled'
  }`
);

console.log(
  `Tests: ${
    config.tests?.enabled ? 'enabled' : 'disabled'
  }`
);

console.log();


// ==================================================
// Determine Angular CLI command
// ==================================================

const angularCli =
  process.platform === 'win32'
    ? 'ng.cmd'
    : 'ng';


// ==================================================
// Angular CLI arguments
// ==================================================

const angularArgs = [
  'generate',
  'application',
  projectName,

  '--project-root',
  `projects/${projectName}`,

  '--style',
  'scss',

  '--routing',
  'false',

  '--skip-tests',
  'false',

  '--skip-install'
];


// ==================================================
// Display command
// ==================================================

console.log(
  `Running: ng ${angularArgs.join(' ')}`
);

console.log();


// ==================================================
// Run Angular CLI
// ==================================================

const angularResult = spawnSync(
  angularCli,
  angularArgs,
  {
    cwd: repoRoot,

    stdio: 'inherit',

    shell: true
  }
);


// ==================================================
// Handle process startup error
// ==================================================

if (angularResult.error) {
  console.error();

  console.error(
    'Failed to start Angular CLI.'
  );

  console.error(
    angularResult.error
  );

  throw angularResult.error;
}


// ==================================================
// Handle Angular CLI failure
// ==================================================

if (angularResult.status !== 0) {
  console.error();

  console.error(
    `Angular CLI exited with code: ${angularResult.status}`
  );

  throw new Error(
    'Angular application generation failed.'
  );
}


// ==================================================
// Verify generated project
// ==================================================

if (!fs.existsSync(projectPath)) {
  throw new Error(
    `Angular CLI completed, but the project directory was not found:\n${projectPath}`
  );
}


// ==================================================
// Success
// ==================================================

console.log();

console.log('======================================');
console.log(' Angular application created');
console.log('======================================');

console.log();

console.log(
  `Project: ${projectName}`
);

console.log(
  `Location: projects/${projectName}`
);

console.log();

console.log(
  'Angular CLI has updated angular.json.'
);

console.log();

console.log(
  'NYBOSS-specific generation will be added next.'
);

console.log();// Check project path
// --------------------------------------------------

const projectPath = path.join(
  repoRoot,
  'projects',
  projectName
);

if (fs.existsSync(projectPath)) {
  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );
}

console.log(`Project path: ${projectPath}`);
console.log();


// --------------------------------------------------
// Generate Angular application
// --------------------------------------------------

console.log('Creating Angular application...');
console.log();

const angularCli =
  process.platform === 'win32'
    ? 'ng.cmd'
    : 'ng';

const angularArgs = [
  'generate',
  'application',
  projectName,

  '--project-root',
  `projects/${projectName}`,

  '--style',
  'scss',

  '--routing',
  'false',

  '--skip-tests',
  'false',

  '--skip-install'
];

console.log(
  `Running: ng ${angularArgs.join(' ')}`
);

console.log();


const result = spawnSync(
  angularCli,
  angularArgs,
  {
    cwd: repoRoot,

    stdio: 'inherit',

    shell: true
  }
);


// --------------------------------------------------
// Check Angular result
// --------------------------------------------------

if (result.error) {
  console.error();
  console.error(
    'Failed to start Angular CLI:'
  );
  console.error(result.error);

  throw result.error;
}

if (result.status !== 0) {
  console.error();
  console.error(
    `Angular CLI exited with code: ${result.status}`
  );

  throw new Error(
    'Angular application generation failed.'
  );
}


// --------------------------------------------------
// Success
// --------------------------------------------------

console.log();
console.log('======================================');
console.log(' Angular application created');
console.log('======================================');
console.log();

console.log(
  `Project: ${projectName}`
);

console.log(
  `Location: projects/${projectName}`
);

console.log();

console.log(
  'Angular CLI has updated angular.json.'
);

console.log();

console.log(
  'NYBOSS-specific generation will be added next.'
);
const result = spawnSync(
  angularCli,
  [
    'generate',
    'application',
    projectName,
    '--directory',
    `projects/${projectName}`,
    '--style',
    'scss',
    '--routing',
    'false',
    '--skip-tests',
    'false'
  ],
  {
    cwd: repoRoot,
    stdio: 'inherit',
    shell: false
  }
);

if (result.status !== 0) {
  throw new Error(
    'Angular application generation failed.'
  );
}

console.log();
console.log('Angular application created successfully.');
console.log();


// --------------------------------------------------
// 5. Final information
// --------------------------------------------------

console.log('======================================');
console.log(' Generation completed');
console.log('======================================');

console.log(`Project: ${projectName}`);
console.log(`Location: projects/${projectName}`);
console.log();

console.log(
  'Next step: NYBOSS-specific files will be generated here.'
);
