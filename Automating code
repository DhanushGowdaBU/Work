import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

type Operation =
  | 'create'
  | 'modify';


type ComponentType =
  | 'grid'
  | 'wrapper'
  | 'standard';


interface ComponentConfig {
  name: string;

  type: ComponentType;

  /*
   * Optional.
   *
   * Defaults to false.
   */
  viewService?: boolean;

  /*
   * Optional.
   *
   * Defaults to false.
   */
  dataSource?: boolean;

  /*
   * Optional additional component files.
   */
  files?: string[];
}


interface ProjectConfig {
  operation: Operation;

  application: {
    name: string;
  };

  components?: ComponentConfig[];

  models?: string[];

  services?: string[];

  guard?: {
    enabled: boolean;
  };
}


// ==================================================
// Paths
// ==================================================

const generatorRoot =
  path.resolve(__dirname);


const repoRoot =
  path.resolve(
    generatorRoot,
    '../..'
  );


const configPath =
  path.join(
    generatorRoot,
    'nyboss-project.yaml'
  );


const projectsPath =
  path.join(
    repoRoot,
    'projects'
  );


// ==================================================
// Constants
// ==================================================

const mandatoryStore =
  true;


const mandatoryRouting =
  true;


const mandatoryTests =
  true;


// ==================================================
// Helper functions
// ==================================================

function toKebabCase(
  value: string
): string {

  return value
    .replace(
      /([a-z])([A-Z])/g,
      '$1-$2'
    )
    .replace(
      /[\s_]+/g,
      '-'
    )
    .toLowerCase();
}


function createDirectory(
  directoryPath: string
): void {

  fs.mkdirSync(
    directoryPath,
    {
      recursive: true
    }
  );
}


function createFile(
  filePath: string
): void {

  createDirectory(
    path.dirname(filePath)
  );

  fs.writeFileSync(
    filePath,
    ''
  );
}


function fileExists(
  filePath: string
): boolean {

  return fs.existsSync(filePath);
}


// ==================================================
// Angular CLI helper
// ==================================================

function runAngularCommand(
  args: string[],
  description: string
): void {

  const angularCli =
    process.platform === 'win32'
      ? 'ng.cmd'
      : 'ng';


  console.log();
  console.log(description);

  console.log(
    `Running: ng ${args.join(' ')}`
  );

  console.log();


  const result =
    spawnSync(
      angularCli,
      args,
      {
        cwd: repoRoot,
        stdio: 'inherit',
        shell: true
      }
    );


  if (result.error) {

    console.error();

    console.error(
      `Failed to execute Angular CLI: ${description}`
    );

    console.error(
      result.error
    );

    throw result.error;
  }


  if (result.status !== 0) {

    console.error();

    console.error(
      `Angular CLI exited with code ${result.status}`
    );

    throw new Error(
      `Angular CLI operation failed: ${description}`
    );
  }
}


// ==================================================
// Supporting file validation
// ==================================================

function validateSupportingFileName(
  fileName: string
): void {

  const trimmed =
    fileName.trim();


  if (!trimmed) {

    throw new Error(
      'Supporting file name cannot be empty.'
    );
  }


  /*
   * Prevent absolute paths and directory traversal.
   */
  if (
    path.isAbsolute(trimmed) ||
    trimmed.includes('..')
  ) {

    throw new Error(
      `Invalid supporting file path '${fileName}'.`
    );
  }
}


// ==================================================
// Component validation
// ==================================================

function validateComponent(
  component: ComponentConfig
): void {

  if (!component.name?.trim()) {

    throw new Error(
      'Every component must have a name.'
    );
  }


  if (!component.type) {

    throw new Error(
      `Component '${component.name}' must have a type.`
    );
  }


  if (
    component.type !== 'grid' &&
    component.type !== 'wrapper' &&
    component.type !== 'standard'
  ) {

    throw new Error(
      `Invalid component type '${component.type}' ` +
      `for '${component.name}'.\n\n` +

      'Supported component types:\n' +
      '- grid\n' +
      '- wrapper\n' +
      '- standard'
    );
  }


  if (
    component.viewService !== undefined &&
    typeof component.viewService !== 'boolean'
  ) {

    throw new Error(
      `viewService must be true or false ` +
      `for component '${component.name}'.`
    );
  }


  if (
    component.dataSource !== undefined &&
    typeof component.dataSource !== 'boolean'
  ) {

    throw new Error(
      `dataSource must be true or false ` +
      `for component '${component.name}'.`
    );
  }


  if (component.files) {

    if (!Array.isArray(component.files)) {

      throw new Error(
        `files must be a list for ` +
        `component '${component.name}'.`
      );
    }


    for (
      const file of component.files
    ) {

      validateSupportingFileName(file);
    }
  }
}


// ==================================================
// Validate configuration
// ==================================================

function validateConfiguration(
  config: ProjectConfig
): void {

  if (!config.operation) {

    throw new Error(
      'operation is required.'
    );
  }


  if (
    config.operation !== 'create' &&
    config.operation !== 'modify'
  ) {

    throw new Error(
      `Invalid operation '${config.operation}'.\n` +
      'Supported operations: create, modify'
    );
  }


  if (!config.application) {

    throw new Error(
      'The "application" section is required.'
    );
  }


  if (!config.application.name?.trim()) {

    throw new Error(
      'application.name is required.'
    );
  }


  if (config.components) {

    for (
      const component of config.components
    ) {

      validateComponent(component);
    }
  }
}


// ==================================================
// Default components
// ==================================================

function getDefaultComponents(
  projectName: string
): ComponentConfig[] {

  return [
    {
      name: `${projectName}-grid`,
      type: 'grid'
    },

    {
      name: `${projectName}-wrapper`,
      type: 'wrapper'
    },

    {
      name: projectName,
      type: 'standard'
    }
  ];
}


// ==================================================
// Merge components
// ==================================================

function getCreateComponents(
  projectName: string,
  configuredComponents?: ComponentConfig[]
): ComponentConfig[] {

  const defaults =
    getDefaultComponents(projectName);


  const components =
    [
      ...defaults,
      ...(configuredComponents ?? [])
    ];


  const uniqueComponents =
    new Map<string, ComponentConfig>();


  for (
    const component of components
  ) {

    const name =
      toKebabCase(
        component.name
      );


    /*
     * Explicit configuration overrides
     * the default component.
     */
    uniqueComponents.set(
      name,
      {
        ...component,
        name
      }
    );
  }


  return Array.from(
    uniqueComponents.values()
  );
}


// ==================================================
// Mandatory models
// ==================================================

function getModels(
  projectName: string,
  models?: string[]
): string[] {

  const values =
    models?.length
      ? models
      : [projectName];


  return Array.from(
    new Set(
      values.map(
        model =>
          toKebabCase(model)
      )
    )
  );
}


// ==================================================
// Mandatory services
// ==================================================

function getServices(
  projectName: string,
  services?: string[]
): string[] {

  const values =
    services?.length
      ? services
      : [projectName];


  return Array.from(
    new Set(
      values.map(
        service =>
          toKebabCase(service)
      )
    )
  );
}


// ==================================================
// Create component
// ==================================================

function createComponent(
  projectName: string,
  component: ComponentConfig
): void {

  const componentName =
    toKebabCase(
      component.name
    );


  const componentTarget =
    `${projectName}/components/${componentName}`;


  /*
   * Angular CLI generates the standard component
   * files and updates the Angular project configuration.
   */

  const args: string[] = [
    'generate',
    'component',
    componentTarget,

    '--project',
    projectName,

    '--style',
    'scss'
  ];


  runAngularCommand(
    args,
    `Creating component: ${componentName}`
  );


  const componentDirectory =
    path.join(
      projectsPath,
      projectName,
      'src',
      'app',
      projectName,
      'components',
      componentName
    );


  // ----------------------------------------------
  // View service
  // ----------------------------------------------

  if (component.viewService === true) {

    createFile(
      path.join(
        componentDirectory,
        `${componentName}-view.service.ts`
      )
    );


    console.log(
      `Created: ${componentName}-view.service.ts`
    );


    if (mandatoryTests) {

      createFile(
        path.join(
          componentDirectory,
          `${componentName}-view.service.spec.ts`
        )
      );


      console.log(
        `Created: ${componentName}-view.service.spec.ts`
      );
    }
  }


  // ----------------------------------------------
  // Data source
  // ----------------------------------------------

  if (component.dataSource === true) {

    createFile(
      path.join(
        componentDirectory,
        `${componentName}-data-source.service.ts`
      )
    );


    console.log(
      `Created: ${componentName}-data-source.service.ts`
    );


    if (mandatoryTests) {

      createFile(
        path.join(
          componentDirectory,
          `${componentName}-data-source.service.spec.ts`
        )
      );


      console.log(
        `Created: ${componentName}-data-source.service.spec.ts`
      );
    }
  }


  // ----------------------------------------------
  // Additional files
  // ----------------------------------------------

  if (component.files?.length) {

    for (
      const file of component.files
    ) {

      validateSupportingFileName(file);


      const fileName =
        file.trim();


      createFile(
        path.join(
          componentDirectory,
          fileName
        )
      );


      console.log(
        `Created: ${componentName}/${fileName}`
      );
    }
  }
}


// ==================================================
// Create store
// ==================================================

function createStore(
  projectName: string,
  storePath: string
): void {

  if (!mandatoryStore) {
    return;
  }


  console.log();

  console.log(
    'Creating store files...'
  );


  const files = [
    `${projectName}.actions.ts`,
    `${projectName}.effects.ts`,
    `${projectName}.reducer.ts`,
    `${projectName}.selectors.ts`,
    `${projectName}.state.ts`,
    `${projectName}.store.ts`
  ];


  for (
    const file of files
  ) {

    createFile(
      path.join(
        storePath,
        file
      )
    );


    console.log(
      `Created: store/${file}`
    );
  }


  if (mandatoryTests) {

    const specFiles = [
      `${projectName}.effects.spec.ts`,
      `${projectName}.reducer.spec.ts`
    ];


    for (
      const file of specFiles
    ) {

      createFile(
        path.join(
          storePath,
          file
        )
      );


      console.log(
        `Created: store/${file}`
      );
    }
  }
}


// ==================================================
// Create new project
// ==================================================

function createProject(
  config: ProjectConfig,
  projectName: string
): void {

  const projectPath =
    path.join(
      projectsPath,
      projectName
    );


  if (fileExists(projectPath)) {

    throw new Error(
      `Project '${projectName}' already exists.\n` +
      'Use operation: modify to change an existing project.'
    );
  }


  // ----------------------------------------------
  // Angular application
  // ----------------------------------------------

  runAngularCommand(
    [
      'generate',
      'application',
      projectName,

      '--style',
      'scss',

      '--routing',
      'false',

      '--ssr',
      'false',

      '--skip-tests',
      'false',

      '--skip-install',

      '--defaults'
    ],

    'Creating Angular application...'
  );


  // ----------------------------------------------
  // Verify application
  // ----------------------------------------------

  if (!fileExists(projectPath)) {

    throw new Error(
      `Angular CLI completed, but project was not found:\n${projectPath}`
    );
  }


  const generatedAppPath =
    path.join(
      projectPath,
      'src',
      'app'
    );


  if (!fileExists(generatedAppPath)) {

    throw new Error(
      `Angular app directory was not found:\n${generatedAppPath}`
    );
  }


  // ----------------------------------------------
  // NYBOSS paths
  // ----------------------------------------------

  const nybossAppPath =
    path.join(
      generatedAppPath,
      projectName
    );


  const componentsPath =
    path.join(
      nybossAppPath,
      'components'
    );


  const modelsPath =
    path.join(
      nybossAppPath,
      'models'
    );


  const servicesPath =
    path.join(
      nybossAppPath,
      'services'
    );


  const storePath =
    path.join(
      nybossAppPath,
      'store'
    );


  createDirectory(
    nybossAppPath
  );

  createDirectory(
    componentsPath
  );

  createDirectory(
    modelsPath
  );

  createDirectory(
    servicesPath
  );


  // ----------------------------------------------
  // Constants
  // ----------------------------------------------

  createFile(
    path.join(
      nybossAppPath,
      `${projectName}.constants.ts`
    )
  );


  // ----------------------------------------------
  // Routing
  // ----------------------------------------------

  if (mandatoryRouting) {

    createFile(
      path.join(
        nybossAppPath,
        `${projectName}.routes.ts`
      )
    );
  }


  // ----------------------------------------------
  // Guard
  // ----------------------------------------------

  if (config.guard?.enabled === true) {

    createFile(
      path.join(
        nybossAppPath,
        `${projectName}.guard.ts`
      )
    );


    if (mandatoryTests) {

      createFile(
        path.join(
          nybossAppPath,
          `${projectName}.guard.spec.ts`
        )
      );
    }
  }


  // ----------------------------------------------
  // Models
  // ----------------------------------------------

  const models =
    getModels(
      projectName,
      config.models
    );


  for (
    const model of models
  ) {

    createFile(
      path.join(
        modelsPath,
        `${model}.model.ts`
      )
    );
  }


  // ----------------------------------------------
  // Services
  // ----------------------------------------------

  const services =
    getServices(
      projectName,
      config.services
    );


  for (
    const service of services
  ) {

    createFile(
      path.join(
        servicesPath,
        `${service}.service.ts`
      )
    );


    if (mandatoryTests) {

      createFile(
        path.join(
          servicesPath,
          `${service}.service.spec.ts`
        )
      );
    }
  }


  // ----------------------------------------------
  // Components
  // ----------------------------------------------

  const components =
    getCreateComponents(
      projectName,
      config.components
    );


  for (
    const component of components
  ) {

    createComponent(
      projectName,
      component
    );
  }


  // ----------------------------------------------
  // Store
  // ----------------------------------------------

  if (mandatoryStore) {

    createDirectory(
      storePath
    );


    createStore(
      projectName,
      storePath
    );
  }
}


// ==================================================
// Modify existing project
// ==================================================

function modifyProject(
  config: ProjectConfig,
  projectName: string
): void {

  const projectPath =
    path.join(
      projectsPath,
      projectName
    );


  if (!fileExists(projectPath)) {

    throw new Error(
      `Project '${projectName}' does not exist.\n` +
      'Use operation: create to create a new project.'
    );
  }


  const nybossAppPath =
    path.join(
      projectPath,
      'src',
      'app',
      projectName
    );


  if (!fileExists(nybossAppPath)) {

    throw new Error(
      `NYBOSS application directory was not found:\n${nybossAppPath}`
    );
  }


  const componentsPath =
    path.join(
      nybossAppPath,
      'components'
    );


  const modelsPath =
    path.join(
      nybossAppPath,
      'models'
    );


  const servicesPath =
    path.join(
      nybossAppPath,
      'services'
    );


  createDirectory(
    componentsPath
  );

  createDirectory(
    modelsPath
  );

  createDirectory(
    servicesPath
  );


  // ----------------------------------------------
  // Add requested components
  // ----------------------------------------------

  if (config.components?.length) {

    for (
      const component of config.components
    ) {

      createComponent(
        projectName,
        component
      );
    }
  }


  // ----------------------------------------------
  // Add requested models
  // ----------------------------------------------

  if (config.models?.length) {

    for (
      const model of config.models
    ) {

      const modelName =
        toKebabCase(model);


      createFile(
        path.join(
          modelsPath,
          `${modelName}.model.ts`
        )
      );


      console.log(
        `Created: models/${modelName}.model.ts`
      );
    }
  }


  // ----------------------------------------------
  // Add requested services
  // ----------------------------------------------

  if (config.services?.length) {

    for (
      const service of config.services
    ) {

      const serviceName =
        toKebabCase(service);


      createFile(
        path.join(
          servicesPath,
          `${serviceName}.service.ts`
        )
      );


      console.log(
        `Created: services/${serviceName}.service.ts`
      );


      if (mandatoryTests) {

        createFile(
          path.join(
            servicesPath,
            `${serviceName}.service.spec.ts`
          )
        );
      }
    }
  }


  // ----------------------------------------------
  // Add guard when explicitly requested
  // ----------------------------------------------

  if (config.guard?.enabled === true) {

    createFile(
      path.join(
        nybossAppPath,
        `${projectName}.guard.ts`
      )
    );


    if (mandatoryTests) {

      createFile(
        path.join(
          nybossAppPath,
          `${projectName}.guard.spec.ts`
        )
      );
    }
  }
}


// ==================================================
// Main
// ==================================================

function main(): void {

  console.log();

  console.log(
    '======================================'
  );

  console.log(
    ' NYBOSS Angular Project Generator'
  );

  console.log(
    '======================================'
  );

  console.log();


  // ----------------------------------------------
  // Configuration
  // ----------------------------------------------

  if (!fileExists(configPath)) {

    throw new Error(
      `Configuration file not found:\n${configPath}`
    );
  }


  const configText =
    fs.readFileSync(
      configPath,
      'utf8'
    );


  const config =
    parse(
      configText
    ) as ProjectConfig;


  validateConfiguration(
    config
  );


  const projectName =
    toKebabCase(
      config.application.name
    );


  // ----------------------------------------------
  // Validate project name
  // ----------------------------------------------

  if (!/^[a-z0-9-]+$/.test(projectName)) {

    throw new Error(
      `Invalid project name '${projectName}'.`
    );
  }


  console.log(
    `Operation : ${config.operation}`
  );

  console.log(
    `Project   : ${projectName}`
  );

  console.log();


  // ----------------------------------------------
  // Execute operation
  // ----------------------------------------------

  if (
    config.operation === 'create'
  ) {

    createProject(
      config,
      projectName
    );

  } else {

    modifyProject(
      config,
      projectName
    );
  }


  // ----------------------------------------------
  // Final summary
  // ----------------------------------------------

  console.log();

  console.log(
    '======================================'
  );

  console.log(
    ' Generation completed'
  );

  console.log(
    '======================================'
  );

  console.log();

  console.log(
    `Project : ${projectName}`
  );

  console.log(
    `Location: projects/${projectName}`
  );

  console.log();
}


// ==================================================
// Execute
// ==================================================

try {

  main();

} catch (error) {

  console.error();

  console.error(
    '======================================'
  );

  console.error(
    ' Generation failed'
  );

  console.error(
    '======================================'
  );

  console.error();

  console.error(error);

  process.exit(1);
}
