import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Helper functions
// ==================================================

function toKebabCase(value: string): string {
  return value
    .replace(/([a-z])([A-Z])/g, '$1-$2')
    .replace(/[\s_]+/g, '-')
    .toLowerCase();
}


function createDirectory(
  directoryPath: string
): void {
  fs.mkdirSync(
    directoryPath,
    {
      recursive: true
    }
  );
}


function createFile(
  filePath: string
): void {
  createDirectory(
    path.dirname(filePath)
  );

  fs.writeFileSync(
    filePath,
    ''
  );
}


// ==================================================
// Run Angular CLI command
// ==================================================

function runAngularCommand(
  args: string[],
  description: string
): void {

  const angularCli =
    process.platform === 'win32'
      ? 'ng.cmd'
      : 'ng';

  console.log();
  console.log(
    `${description}`
  );

  console.log(
    `Running: ng ${args.join(' ')}`
  );

  console.log();


  const processResult = spawnSync(
    angularCli,
    args,
    {
      cwd: repoRoot,
      stdio: 'inherit',
      shell: true
    }
  );


  if (processResult.error) {

    console.error();

    console.error(
      `Failed to execute Angular CLI for: ${description}`
    );

    console.error(
      processResult.error
    );

    throw processResult.error;
  }


  if (processResult.status !== 0) {

    console.error();

    console.error(
      `Angular CLI exited with code ${
        processResult.status
      }`
    );

    throw new Error(
      `Angular CLI operation failed: ${description}`
    );
  }
}


// ==================================================
// Paths
// ==================================================

const repoRoot = path.resolve(
  __dirname,
  '../..'
);

const configPath = path.join(
  repoRoot,
  'nyboss-project.yaml'
);

const projectsPath = path.join(
  repoRoot,
  'projects'
);


// ==================================================
// Start
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' NYBOSS Angular Project Generator'
);

console.log(
  '======================================'
);

console.log();


// ==================================================
// 1. Check configuration file
// ==================================================

if (!fs.existsSync(configPath)) {

  throw new Error(
    `Configuration file not found:\n${configPath}`
  );
}


// ==================================================
// 2. Read YAML configuration
// ==================================================

const configText = fs.readFileSync(
  configPath,
  'utf8'
);

const config =
  parse(configText) as ProjectConfig;


// ==================================================
// 3. Validate application
// ==================================================

if (!config.application) {

  throw new Error(
    'The "application" section is required in nyboss-project.yaml.'
  );
}


if (!config.application.name) {

  throw new Error(
    'application.name is required in nyboss-project.yaml.'
  );
}


const projectName =
  config.application.name.trim();


// ==================================================
// 4. Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {

  throw new Error(
    `Invalid project name '${projectName}'.\n\n` +
    'NYBOSS project names must contain only:\n' +
    '- lowercase letters (a-z)\n' +
    '- numbers (0-9)\n' +
    '- hyphens (-)\n\n' +
    'Examples:\n' +
    '- instrument\n' +
    '- fibo-client-contact\n' +
    '- pledge-dashboard'
  );
}


if (projectName !== projectName.toLowerCase()) {

  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'NYBOSS project names must be lowercase.'
  );
}


console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// 5. Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {

  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );
}


// ==================================================
// 6. Check existing project
// ==================================================

const projectPath = path.join(
  projectsPath,
  projectName
);


if (fs.existsSync(projectPath)) {

  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );
}


console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// 7. Display requested configuration
// ==================================================

console.log(
  'Requested configuration:'
);

console.log();


console.log(
  `Components: ${
    config.components?.length ?? 0
  }`
);


console.log(
  `Models: ${
    config.models?.length ?? 0
  }`
);


console.log(
  `Services: ${
    config.services?.length ?? 0
  }`
);


console.log(
  `Store: ${
    config.store?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Routing: ${
    config.routing?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Guard: ${
    config.guard?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Tests: ${
    config.tests?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log();


// ==================================================
// 8. Generate base Angular application
// ==================================================

runAngularCommand(
  [
    'generate',
    'application',
    projectName,

    '--style',
    'scss',

    '--routing',
    'false',

    '--skip-tests',
    'false',

    '--skip-install'
  ],
  'Creating Angular application...'
);


// ==================================================
// 9. Verify Angular application
// ==================================================

if (!fs.existsSync(projectPath)) {

  throw new Error(
    `Angular CLI completed, but the expected project directory was not found:\n${projectPath}`
  );
}


const generatedAppPath = path.join(
  projectPath,
  'src',
  'app'
);


if (!fs.existsSync(generatedAppPath)) {

  throw new Error(
    `Angular CLI completed, but the expected Angular app directory was not found:\n${generatedAppPath}`
  );
}


// ==================================================
// 10. Create NYBOSS application directory
// ==================================================

const nybossAppPath = path.join(
  generatedAppPath,
  projectName
);


const componentsPath = path.join(
  nybossAppPath,
  'components'
);


const modelsPath = path.join(
  nybossAppPath,
  'models'
);


const servicesPath = path.join(
  nybossAppPath,
  'services'
);


const storePath = path.join(
  nybossAppPath,
  'store'
);


createDirectory(
  nybossAppPath
);

createDirectory(
  componentsPath
);

createDirectory(
  modelsPath
);

createDirectory(
  servicesPath
);


if (config.store?.enabled) {

  createDirectory(
    storePath
  );
}


// ==================================================
// 11. Create constants file
// ==================================================

createFile(
  path.join(
    nybossAppPath,
    `${projectName}.constants.ts`
  )
);

console.log(
  `Created: ${projectName}.constants.ts`
);


// ==================================================
// 12. Create routing file
// ==================================================

if (config.routing?.enabled) {

  createFile(
    path.join(
      nybossAppPath,
      `${projectName}.routes.ts`
    )
  );

  console.log(
    `Created: ${projectName}.routes.ts`
  );
}


// ==================================================
// 13. Create guard using Angular CLI
// ==================================================

if (config.guard?.enabled) {

  const guardPath =
    `${projectName}/${projectName}`;

  const guardArgs = [
    'generate',
    'guard',
    guardPath,

    '--functional',

    '--skip-tests',
    config.tests?.enabled
      ? 'false'
      : 'true'
  ];


  runAngularCommand(
    guardArgs,
    'Creating application guard...'
  );


  /*
   * Angular CLI creates the guard using its normal
   * generated content.
   *
   * We want the final NYBOSS naming convention:
   *
   * <project-name>.guard.ts
   *
   * Therefore we check the generated location and
   * move/rename it into the NYBOSS application folder.
   */

  const generatedGuardPath =
    path.join(
      generatedAppPath,
      `${projectName}.guard.ts`
    );


  const generatedGuardSpecPath =
    path.join(
      generatedAppPath,
      `${projectName}.guard.spec.ts`
    );


  const targetGuardPath =
    path.join(
      nybossAppPath,
      `${projectName}.guard.ts`
    );


  const targetGuardSpecPath =
    path.join(
      nybossAppPath,
      `${projectName}.guard.spec.ts`
    );


  if (fs.existsSync(generatedGuardPath)) {

    fs.renameSync(
      generatedGuardPath,
      targetGuardPath
    );

    console.log(
      `Moved: ${projectName}.guard.ts`
    );
  }


  if (
    config.tests?.enabled &&
    fs.existsSync(generatedGuardSpecPath)
  ) {

    fs.renameSync(
      generatedGuardSpecPath,
      targetGuardSpecPath
    );

    console.log(
      `Moved: ${projectName}.guard.spec.ts`
    );
  }
}


// ==================================================
// 14. Generate models
// ==================================================

if (config.models?.length) {

  console.log();

  console.log(
    'Creating model files...'
  );


  for (
    const model of config.models
  ) {

    const modelName =
      toKebabCase(model);


    /*
     * Models are not Angular CLI entities.
     * Therefore we create the file itself.
     *
     * Content is intentionally empty.
     */

    const modelPath =
      path.join(
        modelsPath,
        `${modelName}.model.ts`
      );


    createFile(
      modelPath
    );


    console.log(
      `Created: models/${modelName}.model.ts`
    );
  }
}


// ==================================================
// 15. Generate services using Angular CLI
// ==================================================

if (config.services?.length) {

  console.log();

  console.log(
    'Creating services...'
  );


  for (
    const service of config.services
  ) {

    const serviceName =
      toKebabCase(service);


    const serviceTarget =
      `${projectName}/services/${serviceName}`;


    const serviceArgs = [
      'generate',
      'service',
      serviceTarget
    ];


    if (!config.tests?.enabled) {

      serviceArgs.push(
        '--skip-tests'
      );
    }


    runAngularCommand(
      serviceArgs,
      `Creating service: ${serviceName}`
    );
  }
}


// ==================================================
// 16. Generate components using Angular CLI
// ==================================================

if (config.components?.length) {

  console.log();

  console.log(
    'Creating components...'
  );


  for (
    const component of config.components
  ) {

    const componentName =
      toKebabCase(component.name);


    const componentType =
      component.type
        .trim()
        .toLowerCase();


    const componentTarget =
      `${projectName}/components/${componentName}`;


    const componentArgs = [
      'generate',
      'component',
      componentTarget,

      '--style',
      'scss'
    ];


    if (!config.tests?.enabled) {

      componentArgs.push(
        '--skip-tests'
      );
    }


    runAngularCommand(
      componentArgs,
      `Creating component: ${componentName}`
    );


    // ----------------------------------------------
    // Grid-specific files
    // ----------------------------------------------

    if (componentType === 'grid') {

      const dataSourcePath =
        path.join(
          componentsPath,
          componentName,
          `${componentName}-data-source.service.ts`
        );


      createFile(
        dataSourcePath
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentsPath,
            componentName,
            `${componentName}-data-source.service.spec.ts`
          )
        );
      }


      const viewServicePath =
        path.join(
          componentsPath,
          componentName,
          `${componentName}-view.service.ts`
        );


      createFile(
        viewServicePath
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentsPath,
            componentName,
            `${componentName}-view.service.spec.ts`
          )
        );
      }


      console.log(
        `Created grid-specific files for: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Modal-specific files
    // ----------------------------------------------

    else if (componentType === 'modal') {

      const viewServicePath =
        path.join(
          componentsPath,
          componentName,
          `${componentName}-view.service.ts`
        );


      createFile(
        viewServicePath
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentsPath,
            componentName,
            `${componentName}-view.service.spec.ts`
          )
        );
      }


      console.log(
        `Created modal-specific files for: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Wrapper-specific files
    // ----------------------------------------------

    else if (componentType === 'wrapper') {

      const viewServicePath =
        path.join(
          componentsPath,
          componentName,
          `${componentName}-view.service.ts`
        );


      createFile(
        viewServicePath
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentsPath,
            componentName,
            `${componentName}-view.service.spec.ts`
          )
        );
      }


      console.log(
        `Created wrapper-specific files for: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Standard component
    // ----------------------------------------------

    else if (componentType === 'standard') {

      console.log(
        `Created standard component: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Unknown component type
    // ----------------------------------------------

    else {

      console.warn(
        `Warning: Unknown component type '${component.type}' for '${componentName}'.`
      );

      console.warn(
        'Angular component was created, but no NYBOSS-specific files were added.'
      );
    }
  }
}


// ==================================================
// 17. Generate store files
// ==================================================

if (config.store?.enabled) {

  console.log();

  console.log(
    'Creating store files...'
  );


  /*
   * These are NYBOSS-specific store files.
   * Angular CLI does not generate this complete
   * store structure automatically.
   *
   * Files are currently created empty.
   */

  createFile(
    path.join(
      storePath,
      `${projectName}.actions.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.effects.ts`
    )
  );


  if (config.tests?.enabled) {

    createFile(
      path.join(
        storePath,
        `${projectName}.effects.spec.ts`
      )
    );
  }


  createFile(
    path.join(
      storePath,
      `${projectName}.reducer.ts`
    )
  );


  if (config.tests?.enabled) {

    createFile(
      path.join(
        storePath,
        `${projectName}.reducer.spec.ts`
      )
    );
  }


  createFile(
    path.join(
      storePath,
      `${projectName}.selectors.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.state.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.store.ts`
    )
  );


  console.log(
    `Created store files for: ${projectName}`
  );
}


// ==================================================
// 18. Generation summary
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' Generation completed'
);

console.log(
  '======================================'
);

console.log();

console.log(
  `Project : ${projectName}`
);

console.log(
  `Location: projects/${projectName}`
);

console.log();

console.log(
  'Angular CLI generated Angular-native files with boilerplate.'
);

console.log(
  'NYBOSS-specific files were created according to the configuration.'
);

console.log();

console.log(
  'Note: NYBOSS-specific files are currently empty.'
);

console.log();
