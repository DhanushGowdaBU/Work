import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Paths
// ==================================================

const repoRoot = path.resolve(__dirname, '../..');

const configPath = path.join(
  repoRoot,
  'nyboss-project.yaml'
);

const projectsPath = path.join(
  repoRoot,
  'projects'
);


// ==================================================
// Start
// ==================================================

console.log();
console.log('======================================');
console.log(' NYBOSS Angular Project Generator');
console.log('======================================');
console.log();


// ==================================================
// 1. Check configuration file
// ==================================================

if (!fs.existsSync(configPath)) {
  throw new Error(
    `Configuration file not found:\n${configPath}`
  );
}


// ==================================================
// 2. Read YAML
// ==================================================

const configText = fs.readFileSync(
  configPath,
  'utf8'
);

const config = parse(
  configText
) as ProjectConfig;


// ==================================================
// 3. Validate application
// ==================================================

if (!config.application) {
  throw new Error(
    'The "application" section is required in nyboss-project.yaml'
  );
}

if (!config.application.name) {
  throw new Error(
    'application.name is required in nyboss-project.yaml'
  );
}

const projectName =
  config.application.name.trim();

console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// 4. Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {
  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'Project names can contain only lowercase letters, numbers and hyphens.'
  );
}


// ==================================================
// 5. Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {
  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );
}


// ==================================================
// 6. Check if project already exists
// ==================================================

const projectPath = path.join(
  projectsPath,
  projectName
);

if (fs.existsSync(projectPath)) {
  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );
}

console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// 7. Display requested configuration
// ==================================================

console.log('Requested configuration:');
console.log();

console.log(
  `Components: ${
    config.components?.length ?? 0
  }`
);

console.log(
  `Models: ${
    config.models?.length ?? 0
  }`
);

console.log(
  `Services: ${
    config.services?.length ?? 0
  }`
);

console.log(
  `Store: ${
    config.store?.enabled ? 'Enabled' : 'Disabled'
  }`
);

console.log(
  `Routing: ${
    config.routing?.enabled ? 'Enabled' : 'Disabled'
  }`
);

console.log(
  `Guard: ${
    config.guard?.enabled ? 'Enabled' : 'Disabled'
  }`
);

console.log(
  `Tests: ${
    config.tests?.enabled ? 'Enabled' : 'Disabled'
  }`
);

console.log();


// ==================================================
// 8. Generate Angular application
// ==================================================

console.log(
  'Creating Angular application...'
);

console.log();

const angularCli =
  process.platform === 'win32'
    ? 'ng.cmd'
    : 'ng';


// Angular CLI arguments
const angularArgs = [
  'generate',
  'application',
  projectName,

  '--style',
  'scss',

  '--routing',
  'false',

  '--skip-tests',
  'false',

  '--skip-install'
];


console.log(
  `Running: ng ${angularArgs.join(' ')}`
);

console.log();


// ==================================================
// 9. Execute Angular CLI
// ==================================================

const angularProcess = spawnSync(
  angularCli,
  angularArgs,
  {
    cwd: repoRoot,

    stdio: 'inherit',

    shell: true
  }
);


// ==================================================
// 10. Check Angular CLI execution
// ==================================================

if (angularProcess.error) {

  console.error();

  console.error(
    'Failed to start Angular CLI.'
  );

  console.error(
    angularProcess.error
  );

  throw angularProcess.error;
}


if (angularProcess.status !== 0) {

  console.error();

  console.error(
    `Angular CLI exited with code: ${
      angularProcess.status
    }`
  );

  throw new Error(
    'Angular application generation failed.'
  );
}


// ==================================================
// 11. Verify generated project
// ==================================================

if (!fs.existsSync(projectPath)) {

  throw new Error(
    `Angular CLI completed, but the expected project directory was not found:\n${projectPath}`
  );
}


// ==================================================
// 12. Success
// ==================================================

console.log();

console.log('======================================');
console.log(' Angular application created');
console.log('======================================');

console.log();

console.log(
  `Project : ${projectName}`
);

console.log(
  `Location: projects/${projectName}`
);

console.log();

console.log(
  'Angular CLI has updated the workspace configuration.'
);

console.log();

console.log(
  'NYBOSS-specific generation will be added next.'
);

console.log();
