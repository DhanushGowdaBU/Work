function generateModel(
  modelName: string,
  modelsPath: string
): void {

  const normalizedName =
    toKebabCase(modelName);

  const className =
    toPascalCase(normalizedName);


  const modelPath =
    path.join(
      modelsPath,
      `${normalizedName}.model.ts`
    );


  createFile(
    modelPath,

    `export interface ${className}Model {
}
`
  );


  console.log(
    `Created model: ${normalizedName}.model.ts`
  );
}


