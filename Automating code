import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}

const repoRoot = path.resolve(__dirname, '../..');
const configPath = path.join(repoRoot, 'nyboss-project.yaml');

console.log('======================================');
console.log(' NYBOSS Angular Project Generator');
console.log('======================================');
console.log();


// --------------------------------------------------
// 1. Read configuration
// --------------------------------------------------

if (!fs.existsSync(configPath)) {
  throw new Error(`Configuration file not found: ${configPath}`);
}

const configText = fs.readFileSync(configPath, 'utf8');

const config = parse(configText) as ProjectConfig;

if (!config.application?.name) {
  throw new Error(
    'Application name is required in nyboss-project.yaml'
  );
}

const projectName = config.application.name.trim();

console.log(`Project name: ${projectName}`);


// --------------------------------------------------
// 2. Validate project name
// --------------------------------------------------

if (!/^[a-z0-9-]+$/.test(projectName)) {
  throw new Error(
    `Invalid project name '${projectName}'. ` +
    'Use lowercase letters, numbers and hyphens only.'
  );
}


// --------------------------------------------------
// 3. Check whether project already exists
// --------------------------------------------------

const projectPath = path.join(repoRoot, 'projects', projectName);

if (fs.existsSync(projectPath)) {
  throw new Error(
    `Project '${projectName}' already exists at ${projectPath}`
  );
}

console.log(`Project path: ${projectPath}`);
console.log();


// --------------------------------------------------
// 4. Create Angular application
// --------------------------------------------------

console.log('Creating Angular application...');
console.log();

const angularCli = process.platform === 'win32'
  ? 'ng.cmd'
  : 'ng';

const result = spawnSync(
  angularCli,
  [
    'generate',
    'application',
    projectName,
    '--directory',
    `projects/${projectName}`,
    '--style',
    'scss',
    '--routing',
    'false',
    '--skip-tests',
    'false'
  ],
  {
    cwd: repoRoot,
    stdio: 'inherit',
    shell: false
  }
);

if (result.status !== 0) {
  throw new Error(
    'Angular application generation failed.'
  );
}

console.log();
console.log('Angular application created successfully.');
console.log();


// --------------------------------------------------
// 5. Final information
// --------------------------------------------------

console.log('======================================');
console.log(' Generation completed');
console.log('======================================');

console.log(`Project: ${projectName}`);
console.log(`Location: projects/${projectName}`);
console.log();

console.log(
  'Next step: NYBOSS-specific files will be generated here.'
);
