import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Paths
// ==================================================

const repoRoot = path.resolve(
  __dirname,
  '../..'
);

const configPath = path.join(
  repoRoot,
  'nyboss-project.yaml'
);

const projectsPath = path.join(
  repoRoot,
  'projects'
);


// ==================================================
// Helper functions
// ==================================================

function toKebabCase(value: string): string {
  return value
    .replace(/([a-z])([A-Z])/g, '$1-$2')
    .replace(/[\s_]+/g, '-')
    .toLowerCase();
}


function createDirectory(
  directoryPath: string
): void {

  fs.mkdirSync(
    directoryPath,
    {
      recursive: true
    }
  );
}


function createFile(
  filePath: string
): void {

  createDirectory(
    path.dirname(filePath)
  );

  fs.writeFileSync(
    filePath,
    ''
  );
}


// ==================================================
// Angular CLI helper
// ==================================================

function runAngularCommand(
  args: string[],
  description: string
): void {

  const angularCli =
    process.platform === 'win32'
      ? 'ng.cmd'
      : 'ng';


  console.log();

  console.log(
    description
  );

  console.log(
    `Running: ng ${args.join(' ')}`
  );

  console.log();


  const result = spawnSync(
    angularCli,
    args,
    {
      cwd: repoRoot,
      stdio: 'inherit',
      shell: true
    }
  );


  if (result.error) {

    console.error();

    console.error(
      `Failed to execute Angular CLI: ${description}`
    );

    console.error(
      result.error
    );

    throw result.error;
  }


  if (result.status !== 0) {

    console.error();

    console.error(
      `Angular CLI exited with code ${result.status}`
    );

    throw new Error(
      `Angular CLI operation failed: ${description}`
    );
  }
}


// ==================================================
// Start
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' NYBOSS Angular Project Generator'
);

console.log(
  '======================================'
);

console.log();


// ==================================================
// 1. Check configuration file
// ==================================================

if (!fs.existsSync(configPath)) {

  throw new Error(
    `Configuration file not found:\n${configPath}`
  );
}


// ==================================================
// 2. Read configuration
// ==================================================

const configText =
  fs.readFileSync(
    configPath,
    'utf8'
  );


const config =
  parse(configText) as ProjectConfig;


// ==================================================
// 3. Validate application
// ==================================================

if (!config.application) {

  throw new Error(
    'The "application" section is required in nyboss-project.yaml.'
  );
}


if (!config.application.name) {

  throw new Error(
    'application.name is required in nyboss-project.yaml.'
  );
}


const projectName =
  config.application.name.trim();


// ==================================================
// 4. Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {

  throw new Error(
    `Invalid project name '${projectName}'.\n\n` +
    'NYBOSS project names must contain only:\n' +
    '- lowercase letters (a-z)\n' +
    '- numbers (0-9)\n' +
    '- hyphens (-)'
  );
}


if (
  projectName !==
  projectName.toLowerCase()
) {

  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'NYBOSS project names must be lowercase.'
  );
}


console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// 5. Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {

  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );
}


// ==================================================
// 6. Check existing project
// ==================================================

const projectPath =
  path.join(
    projectsPath,
    projectName
  );


if (fs.existsSync(projectPath)) {

  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );
}


console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// 7. Display configuration
// ==================================================

console.log(
  'Requested configuration:'
);

console.log();

console.log(
  `Components: ${config.components?.length ?? 0}`
);

console.log(
  `Models: ${config.models?.length ?? 0}`
);

console.log(
  `Services: ${config.services?.length ?? 0}`
);

console.log(
  `Store: ${
    config.store?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Routing: ${
    config.routing?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Guard: ${
    config.guard?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Tests: ${
    config.tests?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log();


// ==================================================
// 8. Create Angular application
// ==================================================

runAngularCommand(
  [
    'generate',
    'application',
    projectName,

    '--style',
    'scss',

    '--routing',
    'false',

    '--skip-tests',
    'false',

    '--skip-install'
  ],

  'Creating Angular application...'
);


// ==================================================
// 9. Verify application
// ==================================================

if (!fs.existsSync(projectPath)) {

  throw new Error(
    `Angular CLI completed, but the expected project directory was not found:\n${projectPath}`
  );
}


const generatedAppPath =
  path.join(
    projectPath,
    'src',
    'app'
  );


if (!fs.existsSync(generatedAppPath)) {

  throw new Error(
    `Angular app directory was not found:\n${generatedAppPath}`
  );
}


// ==================================================
// 10. NYBOSS application paths
// ==================================================

const nybossAppPath =
  path.join(
    generatedAppPath,
    projectName
  );


const componentsPath =
  path.join(
    nybossAppPath,
    'components'
  );


const modelsPath =
  path.join(
    nybossAppPath,
    'models'
  );


const servicesPath =
  path.join(
    nybossAppPath,
    'services'
  );


const storePath =
  path.join(
    nybossAppPath,
    'store'
  );


// ==================================================
// 11. Create NYBOSS base folders
// ==================================================

createDirectory(
  nybossAppPath
);

createDirectory(
  componentsPath
);

createDirectory(
  modelsPath
);

createDirectory(
  servicesPath
);


if (config.store?.enabled) {

  createDirectory(
    storePath
  );
}


// ==================================================
// 12. Constants
// ==================================================

createFile(
  path.join(
    nybossAppPath,
    `${projectName}.constants.ts`
  )
);

console.log(
  `Created: ${projectName}.constants.ts`
);


// ==================================================
// 13. Routes
// ==================================================

if (config.routing?.enabled) {

  createFile(
    path.join(
      nybossAppPath,
      `${projectName}.routes.ts`
    )
  );

  console.log(
    `Created: ${projectName}.routes.ts`
  );
}


// ==================================================
// 14. Guard
// ==================================================

if (config.guard?.enabled) {

  const guardArgs = [
    'generate',
    'guard',

    `${projectName}/${projectName}`,

    '--project',
    projectName,

    '--functional'
  ];


  if (!config.tests?.enabled) {

    guardArgs.push(
      '--skip-tests'
    );
  }


  runAngularCommand(
    guardArgs,
    'Creating application guard...'
  );


  console.log(
    `Guard generated for: ${projectName}`
  );
}


// ==================================================
// 15. Models
// ==================================================

if (config.models?.length) {

  console.log();

  console.log(
    'Creating model files...'
  );


  for (
    const model of config.models
  ) {

    const modelName =
      toKebabCase(model);


    const modelPath =
      path.join(
        modelsPath,
        `${modelName}.model.ts`
      );


    createFile(
      modelPath
    );


    console.log(
      `Created: models/${modelName}.model.ts`
    );
  }
}


// ==================================================
// 16. Services
// ==================================================

if (config.services?.length) {

  console.log();

  console.log(
    'Creating services...'
  );


  for (
    const service of config.services
  ) {

    const serviceName =
      toKebabCase(service);


    const serviceTarget =
      `${projectName}/services/${serviceName}`;


    const serviceArgs = [
      'generate',
      'service',

      serviceTarget,

      '--project',
      projectName
    ];


    if (!config.tests?.enabled) {

      serviceArgs.push(
        '--skip-tests'
      );
    }


    runAngularCommand(
      serviceArgs,
      `Creating service: ${serviceName}`
    );
  }
}


// ==================================================
// 17. Components
// ==================================================

if (config.components?.length) {

  console.log();

  console.log(
    'Creating components...'
  );


  for (
    const component of config.components
  ) {

    const componentName =
      toKebabCase(
        component.name
      );


    const componentType =
      component.type
        .trim()
        .toLowerCase();


    const componentTarget =
      `${projectName}/components/${componentName}`;


    const componentArgs = [
      'generate',
      'component',

      componentTarget,

      '--project',
      projectName,

      '--style',
      'scss'
    ];


    if (!config.tests?.enabled) {

      componentArgs.push(
        '--skip-tests'
      );
    }


    runAngularCommand(
      componentArgs,

      `Creating component: ${componentName}`
    );


    const componentDirectory =
      path.join(
        componentsPath,
        componentName
      );


    // ----------------------------------------------
    // Grid
    // ----------------------------------------------

    if (
      componentType === 'grid'
    ) {

      createFile(
        path.join(
          componentDirectory,
          `${componentName}-data-source.service.ts`
        )
      );


      createFile(
        path.join(
          componentDirectory,
          `${componentName}-view.service.ts`
        )
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentDirectory,
            `${componentName}-data-source.service.spec.ts`
          )
        );


        createFile(
          path.join(
            componentDirectory,
            `${componentName}-view.service.spec.ts`
          )
        );
      }


      console.log(
        `Created grid-specific files for: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Modal
    // ----------------------------------------------

    else if (
      componentType === 'modal'
    ) {

      createFile(
        path.join(
          componentDirectory,
          `${componentName}-view.service.ts`
        )
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentDirectory,
            `${componentName}-view.service.spec.ts`
          )
        );
      }


      console.log(
        `Created modal-specific files for: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Wrapper
    // ----------------------------------------------

    else if (
      componentType === 'wrapper'
    ) {

      createFile(
        path.join(
          componentDirectory,
          `${componentName}-view.service.ts`
        )
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentDirectory,
            `${componentName}-view.service.spec.ts`
          )
        );
      }


      console.log(
        `Created wrapper-specific files for: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Standard
    // ----------------------------------------------

    else if (
      componentType === 'standard'
    ) {

      console.log(
        `Created standard component: ${componentName}`
      );
    }


    // ----------------------------------------------
    // Unknown
    // ----------------------------------------------

    else {

      console.warn(
        `Warning: Unknown component type '${component.type}' for '${componentName}'.`
      );

      console.warn(
        'Only the standard Angular component was generated.'
      );
    }
  }
}


// ==================================================
// 18. Store
// ==================================================

if (config.store?.enabled) {

  console.log();

  console.log(
    'Creating store files...'
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.actions.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.effects.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.reducer.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.selectors.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.state.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.store.ts`
    )
  );


  if (config.tests?.enabled) {

    createFile(
      path.join(
        storePath,
        `${projectName}.effects.spec.ts`
      )
    );


    createFile(
      path.join(
        storePath,
        `${projectName}.reducer.spec.ts`
      )
    );
  }


  console.log(
    `Created store files for: ${projectName}`
  );
}


// ==================================================
// 19. Final summary
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' Generation completed'
);

console.log(
  '======================================'
);

console.log();

console.log(
  `Project : ${projectName}`
);

console.log(
  `Location: projects/${projectName}`
);

console.log();

console.log(
  'Angular CLI generated Angular-native files.'
);

console.log(
  'NYBOSS-specific folders and files were created.'
);

console.log();

console.log(
  'Angular-generated files contain standard Angular boilerplate.'
);

console.log(
  'NYBOSS-specific files are currently empty.'
);

console.log();
