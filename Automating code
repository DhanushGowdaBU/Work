import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ComponentConfig {
  name: string;
  type: string;

  /*
   * Optional NYBOSS-specific supporting files.
   *
   * These default to false when not specified.
   */
  viewService?: boolean;
  dataSource?: boolean;

  /*
   * Generic future supporting files.
   *
   * Example:
   *
   * files:
   *   - customer-helper.ts
   *   - customer-config.ts
   *
   * These files are created inside the component folder.
   */
  files?: string[];
}


interface ProjectConfig {
  application: {
    name: string;
  };

  components?: ComponentConfig[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Paths
// ==================================================

const repoRoot = path.resolve(
  __dirname,
  '../..'
);

const configPath = path.join(
  repoRoot,
  'nyboss-project.yaml'
);

const projectsPath = path.join(
  repoRoot,
  'projects'
);


// ==================================================
// Helper functions
// ==================================================

function toKebabCase(value: string): string {
  return value
    .replace(/([a-z])([A-Z])/g, '$1-$2')
    .replace(/[\s_]+/g, '-')
    .toLowerCase();
}


function createDirectory(
  directoryPath: string
): void {

  fs.mkdirSync(
    directoryPath,
    {
      recursive: true
    }
  );
}


function createFile(
  filePath: string
): void {

  createDirectory(
    path.dirname(filePath)
  );

  fs.writeFileSync(
    filePath,
    ''
  );
}


// ==================================================
// Angular CLI helper
// ==================================================

function runAngularCommand(
  args: string[],
  description: string
): void {

  const angularCli =
    process.platform === 'win32'
      ? 'ng.cmd'
      : 'ng';


  console.log();

  console.log(
    description
  );

  console.log(
    `Running: ng ${args.join(' ')}`
  );

  console.log();


  const result = spawnSync(
    angularCli,
    args,
    {
      cwd: repoRoot,
      stdio: 'inherit',
      shell: true
    }
  );


  if (result.error) {

    console.error();

    console.error(
      `Failed to execute Angular CLI: ${description}`
    );

    console.error(
      result.error
    );

    throw result.error;
  }


  if (result.status !== 0) {

    console.error();

    console.error(
      `Angular CLI exited with code ${result.status}`
    );

    throw new Error(
      `Angular CLI operation failed: ${description}`
    );
  }
}


// ==================================================
// Validate supporting file name
// ==================================================

function validateSupportingFileName(
  fileName: string
): void {

  if (!fileName.trim()) {

    throw new Error(
      'Component supporting file name cannot be empty.'
    );
  }


  /*
   * Prevent absolute paths or paths that escape
   * the component directory.
   */
  if (
    path.isAbsolute(fileName) ||
    fileName.includes('..')
  ) {

    throw new Error(
      `Invalid component supporting file path '${fileName}'.\n` +
      'Supporting files must remain inside the component directory.'
    );
  }
}


// ==================================================
// Start
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' NYBOSS Angular Project Generator'
);

console.log(
  '======================================'
);

console.log();


// ==================================================
// 1. Check configuration file
// ==================================================

if (!fs.existsSync(configPath)) {

  throw new Error(
    `Configuration file not found:\n${configPath}`
  );
}


// ==================================================
// 2. Read configuration
// ==================================================

const configText =
  fs.readFileSync(
    configPath,
    'utf8'
  );


const config =
  parse(configText) as ProjectConfig;


// ==================================================
// 3. Validate application
// ==================================================

if (!config.application) {

  throw new Error(
    'The "application" section is required in nyboss-project.yaml.'
  );
}


if (!config.application.name) {

  throw new Error(
    'application.name is required in nyboss-project.yaml.'
  );
}


const projectName =
  config.application.name.trim();


// ==================================================
// 4. Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {

  throw new Error(
    `Invalid project name '${projectName}'.\n\n` +
    'NYBOSS project names must contain only:\n' +
    '- lowercase letters (a-z)\n' +
    '- numbers (0-9)\n' +
    '- hyphens (-)'
  );
}


if (
  projectName !==
  projectName.toLowerCase()
) {

  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'NYBOSS project names must be lowercase.'
  );
}


console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// 5. Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {

  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );
}


// ==================================================
// 6. Check existing project
// ==================================================

const projectPath =
  path.join(
    projectsPath,
    projectName
  );


if (fs.existsSync(projectPath)) {

  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );
}


console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// 7. Display configuration
// ==================================================

console.log(
  'Requested configuration:'
);

console.log();

console.log(
  `Components: ${config.components?.length ?? 0}`
);

console.log(
  `Models: ${config.models?.length ?? 0}`
);

console.log(
  `Services: ${config.services?.length ?? 0}`
);

console.log(
  `Store: ${
    config.store?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Routing: ${
    config.routing?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Guard: ${
    config.guard?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log(
  `Tests: ${
    config.tests?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log();


// ==================================================
// 8. Create Angular application
// ==================================================

runAngularCommand(
  [
    'generate',
    'application',
    projectName,

    '--style',
    'scss',

    '--routing',
    'false',

    '--skip-tests',
    'false',

    '--skip-install'
  ],

  'Creating Angular application...'
);


// ==================================================
// 9. Verify application
// ==================================================

if (!fs.existsSync(projectPath)) {

  throw new Error(
    `Angular CLI completed, but the expected project directory was not found:\n${projectPath}`
  );
}


const generatedAppPath =
  path.join(
    projectPath,
    'src',
    'app'
  );


if (!fs.existsSync(generatedAppPath)) {

  throw new Error(
    `Angular app directory was not found:\n${generatedAppPath}`
  );
}


// ==================================================
// 10. NYBOSS application paths
// ==================================================

const nybossAppPath =
  path.join(
    generatedAppPath,
    projectName
  );


const componentsPath =
  path.join(
    nybossAppPath,
    'components'
  );


const modelsPath =
  path.join(
    nybossAppPath,
    'models'
  );


const servicesPath =
  path.join(
    nybossAppPath,
    'services'
  );


const storePath =
  path.join(
    nybossAppPath,
    'store'
  );


// ==================================================
// 11. Create NYBOSS base folders
// ==================================================

createDirectory(
  nybossAppPath
);

createDirectory(
  componentsPath
);

createDirectory(
  modelsPath
);

createDirectory(
  servicesPath
);


if (config.store?.enabled) {

  createDirectory(
    storePath
  );
}


// ==================================================
// 12. Constants
// ==================================================

createFile(
  path.join(
    nybossAppPath,
    `${projectName}.constants.ts`
  )
);


console.log(
  `Created: ${projectName}.constants.ts`
);


// ==================================================
// 13. Routes
// ==================================================

if (config.routing?.enabled) {

  createFile(
    path.join(
      nybossAppPath,
      `${projectName}.routes.ts`
    )
  );


  console.log(
    `Created: ${projectName}.routes.ts`
  );
}


// ==================================================
// 14. Guard
// ==================================================

if (config.guard?.enabled) {

  /*
   * Guard is intentionally created as a file
   * instead of using Angular CLI.
   *
   * This avoids the existing guard schematic
   * configuration problem in the workspace.
   *
   * angular.json is not modified manually.
   */

  const guardPath =
    path.join(
      nybossAppPath,
      `${projectName}.guard.ts`
    );


  createFile(
    guardPath
  );


  console.log(
    `Created: ${projectName}.guard.ts`
  );


  if (config.tests?.enabled) {

    const guardSpecPath =
      path.join(
        nybossAppPath,
        `${projectName}.guard.spec.ts`
      );


    createFile(
      guardSpecPath
    );


    console.log(
      `Created: ${projectName}.guard.spec.ts`
    );
  }
}


// ==================================================
// 15. Models
// ==================================================

if (config.models?.length) {

  console.log();

  console.log(
    'Creating model files...'
  );


  for (
    const model of config.models
  ) {

    const modelName =
      toKebabCase(model);


    const modelPath =
      path.join(
        modelsPath,
        `${modelName}.model.ts`
      );


    createFile(
      modelPath
    );


    console.log(
      `Created: models/${modelName}.model.ts`
    );
  }
}


// ==================================================
// 16. Services
// ==================================================

if (config.services?.length) {

  console.log();

  console.log(
    'Creating service files...'
  );


  for (
    const service of config.services
  ) {

    const serviceName =
      toKebabCase(service);


    /*
     * Service files are created directly instead
     * of using Angular CLI.
     *
     * Reason:
     * The workspace Angular CLI schematic currently
     * rejects the existing "type" configuration.
     *
     * This generator does not modify angular.json.
     */

    const servicePath =
      path.join(
        servicesPath,
        `${serviceName}.service.ts`
      );


    createFile(
      servicePath
    );


    console.log(
      `Created: services/${serviceName}.service.ts`
    );


    if (config.tests?.enabled) {

      const serviceSpecPath =
        path.join(
          servicesPath,
          `${serviceName}.service.spec.ts`
        );


      createFile(
        serviceSpecPath
      );


      console.log(
        `Created: services/${serviceName}.service.spec.ts`
      );
    }
  }
}


// ==================================================
// 17. Components
// ==================================================

if (config.components?.length) {

  console.log();

  console.log(
    'Creating components...'
  );


  for (
    const component of config.components
  ) {

    const componentName =
      toKebabCase(
        component.name
      );


    const componentType =
      component.type
        .trim()
        .toLowerCase();


    const componentTarget =
      `${projectName}/components/${componentName}`;


    /*
     * Components continue to use Angular CLI
     * because Angular generates the standard
     * component boilerplate.
     */

    const componentArgs: string[] = [
      'generate',
      'component',

      componentTarget,

      '--project',
      projectName,

      '--style',
      'scss'
    ];


    if (!config.tests?.enabled) {

      componentArgs.push(
        '--skip-tests'
      );
    }


    runAngularCommand(
      componentArgs,

      `Creating component: ${componentName}`
    );


    const componentDirectory =
      path.join(
        componentsPath,
        componentName
      );


    // ----------------------------------------------
    // View service
    // ----------------------------------------------

    /*
     * Default:
     * viewService = false
     *
     * Therefore:
     *
     * viewService: true
     *     -> create view service
     *
     * viewService omitted
     *     -> do not create view service
     */

    if (component.viewService === true) {

      createFile(
        path.join(
          componentDirectory,
          `${componentName}-view.service.ts`
        )
      );


      console.log(
        `Created: ${componentName}-view.service.ts`
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentDirectory,
            `${componentName}-view.service.spec.ts`
          )
        );


        console.log(
          `Created: ${componentName}-view.service.spec.ts`
        );
      }
    }


    // ----------------------------------------------
    // Data source service
    // ----------------------------------------------

    /*
     * Default:
     * dataSource = false
     *
     * Therefore:
     *
     * dataSource: true
     *     -> create data source service
     *
     * dataSource omitted
     *     -> do not create data source service
     */

    if (component.dataSource === true) {

      createFile(
        path.join(
          componentDirectory,
          `${componentName}-data-source.service.ts`
        )
      );


      console.log(
        `Created: ${componentName}-data-source.service.ts`
      );


      if (config.tests?.enabled) {

        createFile(
          path.join(
            componentDirectory,
            `${componentName}-data-source.service.spec.ts`
          )
        );


        console.log(
          `Created: ${componentName}-data-source.service.spec.ts`
        );
      }
    }


    // ----------------------------------------------
    // Generic future supporting files
    // ----------------------------------------------

    /*
     * Future NYBOSS-specific files can be added
     * without changing this generator.
     *
     * Example:
     *
     * files:
     *   - customer-helper.ts
     *   - customer-config.ts
     *
     * The files are created exactly as specified.
     */

    if (component.files?.length) {

      for (
        const file of component.files
      ) {

        validateSupportingFileName(file);


        const fileName =
          file.trim();


        const futureFilePath =
          path.join(
            componentDirectory,
            fileName
          );


        createFile(
          futureFilePath
        );


        console.log(
          `Created: ${componentName}/${fileName}`
        );


        /*
         * If the future file is a TypeScript spec file,
         * it is created exactly as requested.
         *
         * We do not automatically create another spec
         * because the generic file may represent any
         * future NYBOSS-specific file type.
         */
      }
    }


    // ----------------------------------------------
    // Component type information
    // ----------------------------------------------

    if (
      componentType !== 'standard' &&
      componentType !== 'grid' &&
      componentType !== 'modal' &&
      componentType !== 'wrapper'
    ) {

      console.warn(
        `Warning: Unknown component type '${component.type}' for '${componentName}'.`
      );
    }


    console.log(
      `Created component: ${componentName} (${componentType})`
    );
  }
}


// ==================================================
// 18. Store
// ==================================================

if (config.store?.enabled) {

  console.log();

  console.log(
    'Creating store files...'
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.actions.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.effects.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.reducer.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.selectors.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.state.ts`
    )
  );


  createFile(
    path.join(
      storePath,
      `${projectName}.store.ts`
    )
  );


  if (config.tests?.enabled) {

    createFile(
      path.join(
        storePath,
        `${projectName}.effects.spec.ts`
      )
    );


    createFile(
      path.join(
        storePath,
        `${projectName}.reducer.spec.ts`
      )
    );
  }


  console.log(
    `Created store files for: ${projectName}`
  );
}


// ==================================================
// 19. Final summary
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' Generation completed'
);

console.log(
  '======================================'
);

console.log();

console.log(
  `Project : ${projectName}`
);

console.log(
  `Location: projects/${projectName}`
);

console.log();

console.log(
  'Angular CLI generated Angular-native files.'
);

console.log(
  'NYBOSS-specific folders and files were created.'
);

console.log();

console.log(
  'NYBOSS-specific files are intentionally empty.'
);

console.log();
