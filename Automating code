import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { parse } from 'yaml';


// ==================================================
// Configuration types
// ==================================================

interface ProjectConfig {
  application: {
    name: string;
  };

  components?: {
    name: string;
    type: string;
  }[];

  models?: string[];

  services?: string[];

  store?: {
    enabled: boolean;
  };

  routing?: {
    enabled: boolean;
  };

  guard?: {
    enabled: boolean;
  };

  tests?: {
    enabled: boolean;
  };
}


// ==================================================
// Helper functions
// ==================================================

function toPascalCase(value: string): string {
  return value
    .split('-')
    .filter(Boolean)
    .map(
      part =>
        part.charAt(0).toUpperCase() +
        part.slice(1)
    )
    .join('');
}


function toKebabCase(value: string): string {
  return value
    .replace(/([a-z])([A-Z])/g, '$1-$2')
    .replace(/[\s_]+/g, '-')
    .toLowerCase();
}


function createFile(
  filePath: string,
  content: string
): void {

  fs.mkdirSync(
    path.dirname(filePath),
    {
      recursive: true
    }
  );

  fs.writeFileSync(
    filePath,
    content
  );
}


function validateComponentType(
  type: string
): void {

  const supportedTypes = [
    'grid',
    'modal',
    'standard',
    'wrapper'
  ];

  if (!supportedTypes.includes(type)) {

    throw new Error(
      `Unsupported component type '${type}'.\n` +
      `Supported types: ${supportedTypes.join(', ')}`
    );
  }
}


// ==================================================
// Component generation
// ==================================================

function generateComponent(
  component: {
    name: string;
    type: string;
  },
  componentsPath: string,
  generateTests: boolean
): void {

  const componentName =
    toKebabCase(component.name);

  const className =
    toPascalCase(componentName);


  validateComponentType(
    component.type
  );


  const componentPath =
    path.join(
      componentsPath,
      componentName
    );


  console.log(
    `Generating component: ${componentName} (${component.type})`
  );


  // ==================================================
  // Component TypeScript
  // ==================================================

  createFile(
    path.join(
      componentPath,
      `${componentName}.component.ts`
    ),

    `import { Component } from '@angular/core';

@Component({
  selector: 'app-${componentName}',
  standalone: true,
  templateUrl: './${componentName}.component.html',
  styleUrl: './${componentName}.component.scss'
})
export class ${className}Component {
}
`
  );


  // ==================================================
  // Component HTML
  // ==================================================

  createFile(
    path.join(
      componentPath,
      `${componentName}.component.html`
    ),

    `<div class="${componentName}">
  ${className} component
</div>
`
  );


  // ==================================================
  // Component SCSS
  // ==================================================

  createFile(
    path.join(
      componentPath,
      `${componentName}.component.scss`
    ),

    `.${componentName} {
}
`
  );


  // ==================================================
  // Component test
  // ==================================================

  if (generateTests) {

    createFile(
      path.join(
        componentPath,
        `${componentName}.component.spec.ts`
      ),

      `import {
  ComponentFixture,
  TestBed
} from '@angular/core/testing';

import {
  ${className}Component
} from './${componentName}.component';


describe('${className}Component', () => {

  let component: ${className}Component;

  let fixture:
    ComponentFixture<${className}Component>;


  beforeEach(async () => {

    await TestBed.configureTestingModule({
      imports: [
        ${className}Component
      ]
    }).compileComponents();


    fixture =
      TestBed.createComponent(
        ${className}Component
      );


    component =
      fixture.componentInstance;


    fixture.detectChanges();
  });


  it('should create', () => {

    expect(component)
      .toBeTruthy();

  });

});
`
    );
  }


  // ==================================================
  // Grid-specific files
  // ==================================================

  if (component.type === 'grid') {

    createFile(
      path.join(
        componentPath,
        `${componentName}-view.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}ViewService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.spec.ts`
        ),

        `import {
  ${className}ViewService
} from './${componentName}-view.service';


describe('${className}ViewService', () => {

  it('should be created', () => {

    const service =
      new ${className}ViewService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }


    createFile(
      path.join(
        componentPath,
        `${componentName}-data-source.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}DataSourceService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-data-source.service.spec.ts`
        ),

        `import {
  ${className}DataSourceService
} from './${componentName}-data-source.service';


describe('${className}DataSourceService', () => {

  it('should be created', () => {

    const service =
      new ${className}DataSourceService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }
  }


  // ==================================================
  // Wrapper-specific files
  // ==================================================

  if (component.type === 'wrapper') {

    createFile(
      path.join(
        componentPath,
        `${componentName}-view.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}ViewService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.spec.ts`
        ),

        `import {
  ${className}ViewService
} from './${componentName}-view.service';


describe('${className}ViewService', () => {

  it('should be created', () => {

    const service =
      new ${className}ViewService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }
  }


  // ==================================================
  // Modal-specific files
  // ==================================================

  if (component.type === 'modal') {

    createFile(
      path.join(
        componentPath,
        `${componentName}-view.service.ts`
      ),

      `import { Injectable } from '@angular/core';

@Injectable({
  providedIn: 'root'
})
export class ${className}ViewService {
}
`
    );


    if (generateTests) {

      createFile(
        path.join(
          componentPath,
          `${componentName}-view.service.spec.ts`
        ),

        `import {
  ${className}ViewService
} from './${componentName}-view.service';


describe('${className}ViewService', () => {

  it('should be created', () => {

    const service =
      new ${className}ViewService();

    expect(service)
      .toBeTruthy();

  });

});
`
      );
    }
  }
}


// ==================================================
// Paths
// ==================================================

const repoRoot =
  path.resolve(
    __dirname,
    '../..'
  );


const configPath =
  path.join(
    repoRoot,
    'nyboss-project.yaml'
  );


const projectsPath =
  path.join(
    repoRoot,
    'projects'
  );


// ==================================================
// Start
// ==================================================

console.log();

console.log(
  '======================================'
);

console.log(
  ' NYBOSS Angular Project Generator'
);

console.log(
  '======================================'
);

console.log();


// ==================================================
// 1. Check configuration file
// ==================================================

if (!fs.existsSync(configPath)) {

  throw new Error(
    `Configuration file not found:\n${configPath}`
  );

}


// ==================================================
// 2. Read YAML
// ==================================================

const configText =
  fs.readFileSync(
    configPath,
    'utf8'
  );


const config =
  parse(
    configText
  ) as ProjectConfig;


// ==================================================
// 3. Validate application
// ==================================================

if (!config.application) {

  throw new Error(
    'The "application" section is required in nyboss-project.yaml.'
  );

}


if (!config.application.name) {

  throw new Error(
    'application.name is required in nyboss-project.yaml.'
  );

}


const projectName =
  config.application.name.trim();


// ==================================================
// 4. Validate project name
// ==================================================

if (!/^[a-z0-9-]+$/.test(projectName)) {

  throw new Error(
    `Invalid project name '${projectName}'.\n\n` +
    'NYBOSS project names must contain only:\n' +
    '- lowercase letters (a-z)\n' +
    '- numbers (0-9)\n' +
    '- hyphens (-)\n\n' +
    'Examples:\n' +
    '- instrument\n' +
    '- fibo-client-contact\n' +
    '- pledge-dashboard'
  );

}


if (projectName !== projectName.toLowerCase()) {

  throw new Error(
    `Invalid project name '${projectName}'.\n` +
    'NYBOSS project names must be lowercase.'
  );

}


console.log(
  `Project name: ${projectName}`
);

console.log();


// ==================================================
// 5. Validate projects directory
// ==================================================

if (!fs.existsSync(projectsPath)) {

  throw new Error(
    `Projects directory not found:\n${projectsPath}`
  );

}


// ==================================================
// 6. Check existing project
// ==================================================

const projectPath =
  path.join(
    projectsPath,
    projectName
  );


if (fs.existsSync(projectPath)) {

  throw new Error(
    `Project '${projectName}' already exists:\n${projectPath}`
  );

}


console.log(
  `Project path: ${projectPath}`
);

console.log();


// ==================================================
// 7. Display configuration
// ==================================================

console.log(
  'Requested configuration:'
);

console.log();


console.log(
  `Components: ${
    config.components?.length ?? 0
  }`
);


console.log(
  `Models: ${
    config.models?.length ?? 0
  }`
);


console.log(
  `Services: ${
    config.services?.length ?? 0
  }`
);


console.log(
  `Store: ${
    config.store?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Routing: ${
    config.routing?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Guard: ${
    config.guard?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);


console.log(
  `Tests: ${
    config.tests?.enabled
      ? 'Enabled'
      : 'Disabled'
  }`
);

console.log();


// ==================================================
// 8. Generate Angular application
// ==================================================

console.log(
  'Creating Angular application...'
);

console.log();


const angularCli =
  process.platform === 'win32'
    ? 'ng.cmd'
    : 'ng';


const angularArgs = [
  'generate',
  'application',
  projectName,

  '--style',
  'scss',

  '--routing',
  'false',

  '--skip-tests',
  'false',

  '--skip-install'
];


console.log(
  `Running: ng ${angularArgs.join(' ')}`
);

console.log();


// ==================================================
// 9. Execute Angular CLI
// ==================================================

const angularProcess =
  spawnSync(
    angularCli,
    angularArgs,
    {
      cwd: repoRoot,
      stdio: 'inherit',
      shell: true
    }
  );


// ==================================================
// 10. Check Angular CLI process
// ==================================================

if (angularProcess.error) {

  console.error();

  console.error(
    'Failed to start Angular CLI.'
  );

  console.error(
    angularProcess.error
  );

  throw angularProcess.error;
}


if (angularProcess.status !== 0) {

  console.error();

  console.error(
    `Angular CLI exited with code: ${
      angularProcess.status
    }`
  );

  throw new Error(
    'Angular application generation failed.'
  );
}


// ==================================================
// 11. Verify generated project
// ==================================================

if (!fs.existsSync(projectPath)) {

  throw new Error(
    `Angular CLI completed, but the expected project directory was not found:\n${projectPath}`
  );

}


const generatedAppPath =
  path.join(
    projectPath,
    'src',
    'app'
  );


if (!fs.existsSync(generatedAppPath)) {

  throw new Error(
    `Angular CLI completed, but the expected Angular app directory was not found:\n${generatedAppPath}`
  );

}


// ==================================================
// 12. Create NYBOSS application structure
// ==================================================

console.log(
  'Creating NYBOSS application structure...'
);

console.log();


const nybossAppPath =
  path.join(
    generatedAppPath,
    projectName
  );


const componentsPath =
  path.join(
    nybossAppPath,
    'components'
  );


const modelsPath =
  path.join(
    nybossAppPath,
    'models'
  );


const servicesPath =
  path.join(
    nybossAppPath,
    'services'
  );


const storePath =
  path.join(
    nybossAppPath,
    'store'
  );


// Components

fs.mkdirSync(
  componentsPath,
  {
    recursive: true
  }
);


// Models

fs.mkdirSync(
  modelsPath,
  {
    recursive: true
  }
);


// Services

fs.mkdirSync(
  servicesPath,
  {
    recursive: true
  }
);


// Store

if (config.store?.enabled) {

  fs.mkdirSync(
    storePath,
    {
      recursive: true
    }
  );

}


console.log(
  `Created: src/app/${projectName}/`
);

console.log(
  'Created: components/'
);

console.log(
  'Created: models/'
);

console.log(
  'Created: services/'
);


if (config.store?.enabled) {

  console.log(
    'Created: store/'
  );

}

console.log();


// ==================================================
// 13. Create application constants
// ==================================================

const applicationClassName =
  toPascalCase(
    projectName
  );


const constantsPath =
  path.join(
    nybossAppPath,
    `${projectName}.constants.ts`
  );


createFile(
  constantsPath,

  `export const ${applicationClassName}Constants = {
};
`
);


console.log(
  `Created: ${projectName}.constants.ts`
);


// ==================================================
// 14. Create routing
// ==================================================

if (config.routing?.enabled) {

  const routesPath =
    path.join(
      nybossAppPath,
      `${projectName}.routes.ts`
    );


  createFile(
    routesPath,

    `import { Routes } from '@angular/router';

export const ${applicationClassName}Routes: Routes = [
];
`
  );


  console.log(
    `Created: ${projectName}.routes.ts`
  );

}


// ==================================================
// 15. Create guard
// ==================================================

if (config.guard?.enabled) {

  const guardPath =
    path.join(
      nybossAppPath,
      `${projectName}.guard.ts`
    );


  createFile(
    guardPath,

    `import { CanActivateFn } from '@angular/router';

export const ${applicationClassName}Guard: CanActivateFn = () => {
  return true;
};
`
  );


  console.log(
    `Created: ${projectName}.guard.ts`
  );


  // ==================================================
  // Guard test
  // ==================================================

  if (config.tests?.enabled) {

    const guardSpecPath =
      path.join(
        nybossAppPath,
        `${projectName}.guard.spec.ts`
      );


    createFile(
      guardSpecPath,

      `import {
  ${applicationClassName}Guard
} from './${projectName}.guard';


describe('${applicationClassName}Guard', () => {

  it('should be defined', () => {

    expect(
      ${applicationClassName}Guard
    ).toBeTruthy();

  });

});
`
    );


    console.log(
      `Created: ${projectName}.guard.spec.ts`
    );

  }

}


console.log();


// ==================================================
// 16. Generate components
// ==================================================

if (config.components?.length) {

  console.log(
    'Generating components...'
  );

  console.log();


  for (
    const component
    of config.components
  ) {

    generateComponent(
      component,
      componentsPath,
      config.tests?.enabled ?? false
    );

  }


  console.log();


  console.log(
    `Generated ${
      config.components.length
    } component(s).`
  );

  console.log();

}


// ==================================================
// 17. Generation summary
// ==================================================

console.log(
  '======================================'
);

console.log(
  ' Generation completed'
);

console.log(
  '======================================'
);

console.log();


console.log(
  `Project : ${projectName}`
);


console.log(
  `Location: projects/${projectName}`
);

console.log();


console.log(
  'Angular workspace configuration has been updated by Angular CLI.'
);

console.log();


console.log(
  'NYBOSS application structure has been created.'
);

console.log();


console.log(
  'Components have been generated according to the configuration.'
);

console.log();
